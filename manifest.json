{
  "manifest_version": 3,
  "name": "YOUR_THEME_NAME",
  "version": "1.0.0",
  "description": "YOUR_THEME_DESCRIPTION",

  "theme": {

    "images": {
      "theme_frame":              "images/theme_frame.png",
      "theme_frame_inactive":     "images/theme_frame_inactive.png",
      "theme_frame_incognito":    "images/theme_frame_incognito.png",
      "theme_toolbar":            "images/theme_toolbar.png",
      "theme_tab_background":     "images/theme_tab_background.png",
      "theme_ntp_background":     "images/theme_ntp_background.png",
      "theme_ntp_attribution":    "images/theme_ntp_attribution.png"
    },

    "colors": {
      "frame":                [ 0,   0,   0   ],
      "frame_inactive":       [ 30,  30,  30  ],
      "frame_incognito":      [ 20,  20,  20  ],
      "toolbar":              [ 255, 255, 255 ],
      "tab_text":             [ 0,   0,   0   ],
      "tab_background_text":  [ 150, 150, 150 ],
      "bookmark_text":        [ 0,   0,   0   ],
      "ntp_background":       [ 255, 255, 255 ],
      "ntp_text":             [ 33,  33,  33  ],
      "ntp_link":             [ 26,  115, 232 ],
      "ntp_link_underline":   [ 26,  115, 232 ],
      "ntp_header":           [ 33,  33,  33  ],
      "omnibox_text":         [ 33,  33,  33  ],
      "omnibox_background":   [ 255, 255, 255 ],
      "button_background":    [ 255, 255, 255 ]
    },

    "tints": {
      "buttons":        [ -1.0, -1.0, -1.0 ],
      "frame":          [ -1.0, -1.0, -1.0 ],
      "frame_inactive": [ -1.0, -1.0,  0.6 ]
    },

    "properties": {
      "ntp_background_alignment": "center",
      "ntp_background_repeat":    "no-repeat",
      "ntp_logo_alternate":       0
    }

  }
}
