---
/**
 * Shortcuts — Chrome OS–style circular app icons in the shelf.
 *
 * Each icon is a 40dp circle (white background, MD3 elevation) holding the
 * site's favicon, fetched from Google's favicon service by domain.
 *
 * Per-item favicon size (the `scale` field, 0–100, percent of the circle):
 *   • 100 → favicon fills the whole circle and is clipped by the circle's
 *           rounded boundary (turns a square favicon into a round app icon).
 *           Best for favicons that ship their own square coloured background.
 *   • < 100 → favicon is scaled down proportionally and centred, leaving the
 *           white circle visible around it. Best for transparent / glyph-only
 *           favicons. e.g. 55 ≈ a small centred glyph; 75 ≈ a larger one.
 *
 * Per-item elevation (the `elevation` field, 0–3):
 *   Maps to MD3 elevation levels. Defaults to 1. Independent of `scale`.
 *
 * Both fields are configurable per shortcut and persisted in
 * chrome.storage.local under `shortcuts`.
 */
---

<div class="shelf-apps" id="shelf-apps" role="list" aria-label="App shortcuts">
  <!-- Populated by script -->
</div>

<script>
  import { storageGet } from '../lib/storage.js';

  // scale: 0–100 (percent of circle)  ·  elevation: 0 | 1 | 2 | 3
  const DEFAULT_SHORTCUTS = [
    { label: 'Gmail',    url: 'https://mail.google.com',     scale: 100, elevation: 5 },
    { label: 'Calendar', url: 'https://calendar.google.com', scale: 100, elevation: 5 },
    { label: 'GitHub',   url: 'https://github.com',          scale: 73,  elevation: 5 },
    { label: 'YouTube',  url: 'https://youtube.com',         scale: 67, elevation: 5 },
    { label: 'Notion',   url: 'https://notion.so',           scale: 73,  elevation: 5 },
    { label: 'Figma',    url: 'https://figma.com',           scale: 67,  elevation: 5 },
    { label: 'Linear',   url: 'https://linear.app',          scale: 90, elevation: 5 },
    { label: 'Vercel',   url: 'https://vercel.com',          scale: 100,  elevation: 5 },
  ];

  /** Resolve a high-res favicon for a URL via Google's favicon service. */
  function faviconFor(url: string): string {
    try {
      const { hostname } = new URL(url);
      return `https://www.google.com/s2/favicons?domain=${hostname}&sz=64`;
    } catch {
      return '';
    }
  }

  const clamp = (n: number, lo: number, hi: number) => Math.max(lo, Math.min(hi, n));

  async function render() {
    const { shortcuts } = await storageGet('shortcuts') as any;
    const items = shortcuts ?? DEFAULT_SHORTCUTS;
    const shelf = document.getElementById('shelf-apps');
    if (!shelf) return;

    shelf.innerHTML = items.map((s: any) => {
      // scale: percent of circle (default 100 = fill + clip). Below 100 shrinks.
      const scale = clamp(typeof s.scale === 'number' ? s.scale : 100, 0, 100);
      const elev  = [0, 1, 2, 3].includes(s.elevation) ? s.elevation : 1; // default: 1
      return `
        <a
          class="shelf-icon"
          href="${s.url}"
          target="_blank"
          rel="noopener noreferrer"
          role="listitem"
          aria-label="${s.label}"
        >
          <span class="shelf-icon__circle elev-${elev}" aria-hidden="true">
            <img
              class="shelf-icon__favicon"
              style="width:${scale}%;height:${scale}%"
              src="${faviconFor(s.url)}"
              alt=""
              loading="lazy"
            />
          </span>
          <span class="shelf-icon__tip" role="tooltip">${s.label}</span>
        </a>
      `;
    }).join('');
  }

  render();
</script>

<!-- is:global — shelf icons are injected at runtime via innerHTML, which never
     receives Astro's scoped [data-astro-cid-*] attribute. Scoped rules would
     not match those nodes, so these (shelf-unique) classes must be global. -->
<style is:global>
  .shelf-apps {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 100%;
  }

  /* ── Shelf icon wrapper — 44dp tap target ───────────────────────── */
  .shelf-icon {
    position: relative;
    display: flex; align-items: center; justify-content: center;
    width: 44px; height: 44px;
    border-radius: var(--md-sys-shape-corner-full);
    text-decoration: none;
    flex-shrink: 0;
    --state-color: var(--md-sys-color-on-surface);
  }

  /* ── White circle (Chrome OS app style) ─────────────────────────── */
  /* Always clips its content to a circle via overflow:hidden, so a
     100%-scale favicon is rounded; centres any smaller favicon.       */
  .shelf-icon__circle {
    position: relative;
    width: 40px; height: 40px;
    border-radius: var(--md-sys-shape-corner-full);
    background: #FFFFFF;
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
    /* Flat by default — elevation is revealed on hover (no zoom). */
    box-shadow: var(--md-sys-elevation-level0);
    transition: box-shadow 150ms cubic-bezier(0.2, 0, 0, 1);
    flex-shrink: 0;
  }

  /* ── Per-item MD3 elevation — revealed only on hover ─────────────── */
  /* At rest every circle is elevation-less; hovering one lifts just it. */
  .shelf-icon:hover .elev-1 { box-shadow: var(--md-sys-elevation-level1); }
  .shelf-icon:hover .elev-2 { box-shadow: var(--md-sys-elevation-level2); }
  .shelf-icon:hover .elev-3 { box-shadow: var(--md-sys-elevation-level3); }

  /* ── Favicon ─────────────────────────────────────────────────────── */
  /* Size comes from an inline width/height percentage (the `scale` field).
     object-fit: cover means a 100% favicon fills the circle edge-to-edge
     (then clipped round); a smaller one is centred by the flex container. */
  .shelf-icon__favicon {
    display: block;
    object-fit: cover;
    pointer-events: none;
  }

  /* ── Hover tooltip — reveals the shortcut name above the shelf ─────────────
     Styled to match the menus: same corner radius (extra-large) and the same
     elevation (level 2) on a surface-container background. */
  .shelf-icon__tip {
    position: absolute;
    bottom: calc(100% + 16px);         /* more gap between tooltip and the bar */
    left: 50%;
    /* Grows from the bar: starts small + lower, scaling from its bottom edge */
    transform-origin: bottom center;
    transform: translateX(-50%) translateY(10px) scale(0.7);
    padding: 10px 18px;
    background: var(--md-sys-color-surface-container);
    color: var(--md-sys-color-on-surface);
    border-radius: var(--md-sys-shape-corner-extra-large); /* same as menus */
    /* Soft dark drop (light backgrounds) + light glow (dark backgrounds) so the
       tooltip stays legible on any wallpaper. */
    box-shadow:
      0 8px 24px rgba(0, 0, 0, 0.28),
      0 0 18px rgba(255, 255, 255, 0.22);
    font: var(--md-sys-typescale-title-small);
    letter-spacing: var(--md-sys-typescale-title-small-tracking);
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity 140ms ease,
                transform 200ms cubic-bezier(0.2, 0, 0, 1);
    z-index: 50;
  }
  .shelf-icon:hover .shelf-icon__tip,
  .shelf-icon:focus-visible .shelf-icon__tip {
    opacity: 1;
    transform: translateX(-50%) translateY(0) scale(1);
    transition-delay: 200ms;           /* brief delay before revealing */
  }
</style>
