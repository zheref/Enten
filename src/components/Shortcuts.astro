---
/**
 * Shortcuts — the shelf's app row plus its collapsing "menu" area.
 *
 * Layout (left → right):
 *   [ configured shortcuts · divider · Chrome bookmarks ]   ← the inline row
 *   [ ┊ · Archived · More ]                                 ← the menu area
 *
 * The menu area is split off by a divider and holds up to two trigger icons:
 *   • Archived — shown only when ≥1 item has been archived. Reveals every
 *                archived item in a fan.
 *   • More (overflow) — shown only when the inline row can't fit every
 *                non-archived item. Reveals the items that didn't fit.
 *
 * Both triggers open a "fan": a vertical popover of horizontal circle-and-label
 * rows that slides up out of the shelf (macOS-dock "Downloads" list style).
 *
 * Responsibilities here: render the model, measure available width and decide
 * what overflows (trailing-first), wire the shared right-click menu (including
 * Archive / Unarchive), and keep bookmark drag-reordering working. The data
 * model and the fan mechanics live in ../lib/shelf-items.js and
 * ../lib/shelf-fan.js respectively.
 */
---

<div class="shelf-apps" id="shelf-apps" role="list" aria-label="App shortcuts">
  <!-- Inline icon row (configured shortcuts + Chrome bookmarks) -->
  <div class="shelf-row" id="shelf-row"><!-- populated by script --></div>

  <!-- Menu area: divider + the (conditional) Archived / Overflow triggers -->
  <div class="shelf-menus" id="shelf-menus">
    <span class="shelf-sep shelf-menus__sep" id="menus-sep" aria-hidden="true" hidden></span>
    <button class="shelf-trigger" id="trigger-archived" type="button" hidden aria-label="Archived">
      <span class="shelf-icon__circle elev-1 shelf-trigger__circle" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
          <path d="M20.54 5.23l-1.39-1.68C18.88 3.21 18.47 3 18 3H6c-.47 0-.88.21-1.16.55L3.46 5.23C3.17 5.57 3 6.02 3 6.5V19c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6.5c0-.48-.17-.93-.46-1.27zM12 17.5L6.5 12H10v-2h4v2h3.5L12 17.5zM5.12 5l.81-1h12l.94 1H5.12z"/>
        </svg>
      </span>
      <span class="shelf-icon__tip" role="tooltip">Archived</span>
    </button>
    <button class="shelf-trigger" id="trigger-overflow" type="button" hidden aria-label="More apps">
      <span class="shelf-icon__circle elev-1 shelf-trigger__circle" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
          <path d="M6 10c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm12 0c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm-6 0c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"/>
        </svg>
      </span>
      <span class="shelf-icon__tip" role="tooltip">More</span>
    </button>
  </div>
</div>

<!-- Fan popovers — populated on render; one open at a time (see shelf-fan.js) -->
<div class="shelf-fan" id="fan-archived" role="list" aria-label="Archived apps" hidden></div>
<div class="shelf-fan" id="fan-overflow" role="list" aria-label="More apps" hidden></div>

<!-- Shared right-click menu for any shelf icon / fan row (anchored in JS) -->
<md-menu id="app-context-menu" positioning="fixed" y-offset="16" anchor-corner="start-start" menu-corner="end-start">
  <md-menu-item id="ctx-newtab">
    <div slot="headline">Open in New Tab</div>
    <svg slot="start" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3z"/>
    </svg>
  </md-menu-item>
  <md-menu-item id="ctx-thistab">
    <div slot="headline">Open in This Tab</div>
    <svg slot="start" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M19 4H5c-1.11 0-2 .9-2 2v12c0 1.1.89 2 2 2h4v-2H5V8h14v10h-4v2h4c1.1 0 2-.9 2-2V6c0-1.1-.89-2-2-2zm-7 6l-4 4h3v6h2v-6h3z"/>
    </svg>
  </md-menu-item>
  <md-menu-item id="ctx-copy">
    <div slot="headline">Copy Link</div>
    <svg slot="start" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11z"/>
    </svg>
  </md-menu-item>
  <md-menu-item id="ctx-adjust">
    <div slot="headline">Customize Icon</div>
    <svg slot="start" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M3 17v2h6v-2H3zM3 5v2h10V5H3zm10 16v-2h8v-2h-8v-2h-2v6h2zM7 9v2H3v2h4v2h2V9H7zm14 4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z"/>
    </svg>
  </md-menu-item>
  <md-divider role="separator"></md-divider>
  <md-menu-item id="ctx-archive">
    <div slot="headline">Archive</div>
    <svg slot="start" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M20.54 5.23l-1.39-1.68C18.88 3.21 18.47 3 18 3H6c-.47 0-.88.21-1.16.55L3.46 5.23C3.17 5.57 3 6.02 3 6.5V19c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6.5c0-.48-.17-.93-.46-1.27zM12 17.5L6.5 12H10v-2h4v2h3.5L12 17.5zM5.12 5l.81-1h12l.94 1H5.12z"/>
    </svg>
  </md-menu-item>
  <md-menu-item id="ctx-unarchive" hidden>
    <div slot="headline">Unarchive</div>
    <svg slot="start" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M20.55 5.22l-1.39-1.68C18.88 3.21 18.47 3 18 3H6c-.47 0-.88.21-1.15.55L3.46 5.22C3.17 5.57 3 6.01 3 6.5V19c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6.5c0-.49-.17-.93-.45-1.28zM12 9.5l5.5 5.5H14v2h-4v-2H6.5L12 9.5zM5.12 5l.82-1h12l.93 1H5.12z"/>
    </svg>
  </md-menu-item>
</md-menu>

<script>
  import { storageSet } from '../lib/storage.js';
  import { showSnackbar } from '../lib/snackbar.js';
  import { openCenteredMenu } from '../lib/menu.js';
  import { loadShelf, iconHTML, rowHTML, setArchived } from '../lib/shelf-items.js';
  import { bindFan, closeFan, isFanOpen, installFanDismissers } from '../lib/shelf-fan.js';

  const GAP = 6;        // matches the flex `gap` between shelf items
  const SAFETY = 12;    // breathing room so we never quite touch the side zones

  // The resolved model is cached so the context menu / fans can look items up.
  let model: { items: any[]; appOverrides: any } = { items: [], appOverrides: {} };

  const $ = (id: string) => document.getElementById(id);

  // ── Render: rebuild the inline row + the Archived fan, then lay out ─────────
  async function render() {
    model = await loadShelf();
    const row = $('shelf-row');
    if (!row) return;

    const visible  = model.items.filter(i => !i.archived);
    const shortcuts = visible.filter(i => i.kind === 'shortcut');
    const bookmarks = visible.filter(i => i.kind === 'bookmark');

    let html = shortcuts.map(it => iconHTML(it, model.appOverrides)).join('');
    if (shortcuts.length && bookmarks.length)
      html += '<span class="shelf-sep shelf-sep--inner" aria-hidden="true"></span>';
    html += bookmarks.map(it => iconHTML(it, model.appOverrides)).join('');
    row.innerHTML = html;

    // Archived fan + trigger (only present when something is archived).
    const archived = model.items.filter(i => i.archived);
    const fanArchived = $('fan-archived')!;
    fanArchived.innerHTML = archived.map(it => rowHTML(it, model.appOverrides)).join('');
    const trigArchived = $('trigger-archived') as HTMLButtonElement;
    trigArchived.hidden = archived.length === 0;
    if (archived.length === 0 && isFanOpen(fanArchived)) closeFan();

    layout();
  }

  // Measure the bar and its two side zones (launcher · status area).
  function measureZones() {
    const shelf = document.querySelector('.shelf') as HTMLElement | null;
    const start = document.querySelector('.shelf__zone--start') as HTMLElement | null;
    const end   = document.querySelector('.shelf__zone--end') as HTMLElement | null;
    const innerW = shelf ? shelf.clientWidth - 24 : 0;   // shelf padding is 0 12px
    return { innerW, lead: start?.scrollWidth || 0, trail: end?.scrollWidth || 0 };
  }

  // ── Layout: measure, decide overflow (trailing-first), populate the fan ─────
  function layout() {
    const row = $('shelf-row');
    if (!row) return;
    const icons    = Array.from(row.querySelectorAll('.shelf-icon')) as HTMLElement[];
    const innerSep = row.querySelector('.shelf-sep--inner') as HTMLElement | null;
    const menusSep = $('menus-sep') as HTMLElement;
    const trigArchived = $('trigger-archived') as HTMLButtonElement;
    const trigOverflow = $('trigger-overflow') as HTMLButtonElement;
    const fanOverflow  = $('fan-overflow')!;

    // Reset to fully-shown so every width measures true.
    icons.forEach(el => { el.hidden = false; });
    if (innerSep) innerSep.hidden = false;
    trigOverflow.hidden = false;

    // The grid (1fr auto 1fr) centres the cluster in the WHOLE bar, but the
    // launcher and the status area aren't the same width — so the visual gap
    // ends up large on the left and tiny on the right. Centre the cluster in
    // the space BETWEEN the two side zones instead (equal gap on each side) by
    // nudging it by half their width difference, and budget against that gap.
    const apps = $('shelf-apps') as HTMLElement;
    const { innerW, lead, trail } = measureZones();
    apps.style.transform = innerW ? `translateX(${Math.round((lead - trail) / 2)}px)` : '';
    const budget = innerW ? innerW - lead - trail - 2 * SAFETY : Infinity;

    const archivedShown = !trigArchived.hidden;
    const itemW     = icons.map(el => el.offsetWidth + GAP);
    const totalItems = itemW.reduce((a, b) => a + b, 0);
    const innerSepW = innerSep ? innerSep.offsetWidth + GAP : 0;
    const sepW      = menusSep.offsetWidth + GAP;
    const archW     = archivedShown ? trigArchived.offsetWidth + GAP : 0;
    const overW     = trigOverflow.offsetWidth + GAP;

    const setInnerSep = (vis: HTMLElement[]) => {
      if (!innerSep) return;
      const hasS = vis.some(el => el.dataset.kind === 'shortcut');
      const hasB = vis.some(el => el.dataset.kind === 'bookmark');
      innerSep.hidden = !(hasS && hasB);
    };

    // Everything fits → no overflow trigger; divider only if Archived is shown.
    const menuNoOverflow = archivedShown ? sepW + archW : 0;
    if (totalItems + innerSepW + menuNoOverflow <= budget) {
      trigOverflow.hidden = true;
      fanOverflow.innerHTML = '';
      if (isFanOpen(fanOverflow)) closeFan();
      menusSep.hidden = !archivedShown;
      setInnerSep(icons);
      return;
    }

    // Overflow: reserve the menu area (divider + [Archived] + Overflow), then
    // greedily keep leading icons until the next one wouldn't fit.
    const reserve = sepW + archW + overW;
    let used = innerSepW;   // conservatively reserve the inner divider
    let k = 0;
    for (; k < icons.length; k++) {
      if (used + itemW[k] > budget - reserve) break;
      used += itemW[k];
    }
    icons.forEach((el, i) => { el.hidden = i >= k; });
    menusSep.hidden = false;
    trigOverflow.hidden = false;

    const overflowed = icons.slice(k);
    fanOverflow.innerHTML = overflowed.map(el => {
      const it = model.items.find(m => m.url === el.dataset.url);
      return it ? rowHTML(it, model.appOverrides) : '';
    }).join('');
    setInnerSep(icons.slice(0, k));
  }

  // ── Shared right-click menu (icons + fan rows) ──────────────────────────────
  let ctxUrl = '', ctxKind = 'shortcut', ctxLabel = '', ctxScale = 85, ctxIcon = '';
  let ctxArchived = false;

  function setupContextMenu() {
    const menu = $('app-context-menu') as any;
    const apps = $('shelf-apps');
    if (!menu || !apps) return;

    document.addEventListener('contextmenu', (e: MouseEvent) => {
      const el = (e.target as HTMLElement).closest('.shelf-icon, .shelf-row-item') as HTMLElement | null;
      if (!el) return;
      e.preventDefault();
      closeFan();   // a fan and the menu shouldn't be open together

      ctxUrl   = el.getAttribute('href') || '';
      ctxKind  = el.dataset.kind || 'shortcut';
      ctxLabel = el.getAttribute('aria-label') || '';
      ctxArchived = !!model.items.find(i => i.url === ctxUrl)?.archived;
      const fav = el.querySelector('.shelf-icon__favicon') as HTMLElement | null;
      ctxScale = parseInt(fav?.style.width || '') || (ctxKind === 'bookmark' ? 85 : 100);
      ctxIcon  = fav?.getAttribute('src') || '';

      // Archive ↔ Unarchive: show whichever applies to this item.
      ($('ctx-archive') as HTMLElement).hidden = ctxArchived;
      ($('ctx-unarchive') as HTMLElement).hidden = !ctxArchived;

      // Anchor the menu over the icon, or over a fan row's circle.
      const anchor = el.classList.contains('shelf-row-item')
        ? (el.querySelector('.shelf-icon__circle') as HTMLElement) : el;
      apps.querySelectorAll('.shelf-icon.menu-active').forEach(x => x.classList.remove('menu-active'));
      if (el.classList.contains('shelf-icon')) el.classList.add('menu-active');
      apps.classList.add('menu-open');
      setTimeout(() => openCenteredMenu(menu, anchor), 120);
    });

    menu.addEventListener('closed', () => {
      apps.classList.remove('menu-open');
      apps.querySelectorAll('.shelf-icon.menu-active').forEach(x => x.classList.remove('menu-active'));
    });

    $('ctx-newtab')?.addEventListener('click', () => { if (ctxUrl) window.open(ctxUrl, '_blank'); });
    $('ctx-thistab')?.addEventListener('click', () => { if (ctxUrl) window.location.href = ctxUrl; });
    $('ctx-copy')?.addEventListener('click', async () => {
      if (!ctxUrl) return;
      try { await navigator.clipboard.writeText(ctxUrl); showSnackbar('Link copied to clipboard'); }
      catch (err) { showSnackbar('Couldn’t copy link'); console.error('[Enten] Copy link failed', err); }
    });
    $('ctx-adjust')?.addEventListener('click', () => {
      if (!ctxUrl) return;
      window.dispatchEvent(new CustomEvent('open-containment', {
        detail: { url: ctxUrl, label: ctxLabel, scale: ctxScale, icon: ctxIcon },
      }));
    });
    $('ctx-archive')?.addEventListener('click', async () => {
      if (!ctxUrl) return;
      await setArchived(ctxUrl, true);
      await render();
      showSnackbar(`Archived ${ctxLabel || 'item'}`);
    });
    $('ctx-unarchive')?.addEventListener('click', async () => {
      if (!ctxUrl) return;
      await setArchived(ctxUrl, false);
      await render();
      showSnackbar(`Restored ${ctxLabel || 'item'}`);
    });
  }

  // ── Drag to reorder bookmark icons (bookmarks only, within the row) ─────────
  function setupReorder() {
    const row = $('shelf-row');
    if (!row) return;
    let dragEl: HTMLElement | null = null;
    let dropAfter: HTMLElement | null = null;

    const indicator = document.createElement('span');
    indicator.className = 'drop-indicator';
    indicator.setAttribute('aria-hidden', 'true');

    const bookmarkIcons = () =>
      Array.from(row.querySelectorAll('.shelf-icon[data-kind="bookmark"]')) as HTMLElement[];

    const nextBookmark = (el: HTMLElement): HTMLElement | null => {
      let n = el.nextElementSibling as HTMLElement | null;
      while (n && !n.matches('.shelf-icon[data-kind="bookmark"]')) n = n.nextElementSibling as HTMLElement | null;
      return n;
    };

    row.addEventListener('dragstart', (e: DragEvent) => {
      const icon = (e.target as HTMLElement).closest('.shelf-icon[data-kind="bookmark"]') as HTMLElement | null;
      if (!icon) return;
      dragEl = icon;
      icon.classList.add('dragging');
      try {
        e.dataTransfer!.effectAllowed = 'move';
        e.dataTransfer!.setData('text/plain', icon.dataset.url || '');
      } catch { /* noop */ }
    });

    row.addEventListener('dragover', (e: DragEvent) => {
      if (!dragEl) return;
      e.preventDefault();
      e.dataTransfer!.dropEffect = 'move';
      indicator.remove();
      const after = bookmarkIcons().filter(el => el !== dragEl).find(el => {
        const r = el.getBoundingClientRect();
        return e.clientX < r.left + r.width / 2;
      }) || null;
      dropAfter = after;
      if (after !== nextBookmark(dragEl)) {
        if (after) row.insertBefore(indicator, after);
        else row.appendChild(indicator);
      }
    });

    row.addEventListener('drop', async (e: DragEvent) => {
      if (!dragEl) return;
      e.preventDefault();
      indicator.remove();
      if (dropAfter !== nextBookmark(dragEl)) {
        if (dropAfter) row.insertBefore(dragEl, dropAfter);
        else row.appendChild(dragEl);
        const order = bookmarkIcons().map(el => el.dataset.url).filter(Boolean);
        await storageSet({ bookmarkOrder: order });
        layout();   // the new order may change what overflows
      }
    });

    row.addEventListener('dragend', () => {
      indicator.remove();
      dragEl?.classList.remove('dragging');
      dragEl = null;
      dropAfter = null;
    });
  }

  // ── Boot ────────────────────────────────────────────────────────────────────
  function setupFans() {
    bindFan($('trigger-archived')!, $('fan-archived')!);
    bindFan($('trigger-overflow')!, $('fan-overflow')!);
    installFanDismissers();
  }

  function watchResize() {
    if (!('ResizeObserver' in window)) {
      window.addEventListener('resize', () => layout());
      return;
    }
    const ro = new ResizeObserver(() => layout());
    const shelf = document.querySelector('.shelf');
    const end   = document.querySelector('.shelf__zone--end');
    if (shelf) ro.observe(shelf);
    if (end) ro.observe(end);   // re-flow when the status area's width changes
  }

  // Allow other components (the containment adjuster) to force a re-render.
  window.addEventListener('shelf-icons-refresh', () => { render(); });

  render();
  setupContextMenu();
  setupReorder();
  setupFans();
  watchResize();
</script>

<!-- is:global — shelf icons / fan rows are injected at runtime via innerHTML,
     which never receives Astro's scoped [data-astro-cid-*] attribute. Scoped
     rules would not match those nodes, so these classes must be global. -->
<style is:global>
  :root {
    /* Shared "pop" shadow — used by the shelf tooltips AND the hover-revealed
       icon elevation. Drop shadow + light glow (so it highlights on dark
       wallpapers too). Level 2 == the tooltip. Original (narrow) blur radii.
       LIGHT MODE: the drop is lightened via a lighter COLOUR (grey), not a thin
       alpha — tweak --shelf-shadow-color to taste. */
    --shelf-shadow-color: 150, 150, 150;
    --shelf-pop-shadow-1: 0 4px 14px rgba(var(--shelf-shadow-color), 0.24), 0 0 12px rgba(255, 255, 255, 0.18);
    --shelf-pop-shadow-2: 0 8px 24px rgba(var(--shelf-shadow-color), 0.28), 0 0 18px rgba(255, 255, 255, 0.22);
    --shelf-pop-shadow-3: 0 12px 32px rgba(var(--shelf-shadow-color), 0.32), 0 0 26px rgba(255, 255, 255, 0.26);
  }
  /* DARK MODE: black drop (original radii). */
  .dark-scheme {
    --shelf-shadow-color: 0, 0, 0;
    --shelf-pop-shadow-1: 0 4px 14px rgba(var(--shelf-shadow-color), 0.30), 0 0 12px rgba(255, 255, 255, 0.20);
    --shelf-pop-shadow-2: 0 8px 24px rgba(var(--shelf-shadow-color), 0.34), 0 0 18px rgba(255, 255, 255, 0.24);
    --shelf-pop-shadow-3: 0 12px 32px rgba(var(--shelf-shadow-color), 0.38), 0 0 26px rgba(255, 255, 255, 0.28);
  }

  .shelf-apps {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 100%;
  }
  .shelf-row, .shelf-menus {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 100%;
  }

  /* Bookmark being dragged to reorder */
  .shelf-icon.dragging { opacity: 0.4; cursor: grabbing; }

  /* Glowing vertical bar previewing the drop position */
  .drop-indicator {
    flex-shrink: 0;
    width: 3px;
    height: 34px;
    margin: 0 2px;
    border-radius: 2px;
    background: var(--md-sys-color-primary);
    animation: drop-indicator-glow 900ms ease-in-out infinite;
  }
  @keyframes drop-indicator-glow {
    0%, 100% { box-shadow: 0 0 6px 0 var(--md-sys-color-primary); opacity: 0.85; }
    50%      { box-shadow: 0 0 12px 2px var(--md-sys-color-primary); opacity: 1; }
  }

  /* Dividers: the inner one (shortcuts / bookmarks) and the menu-area one */
  .shelf-sep {
    width: 1px;
    height: 24px;
    margin: 0 4px;
    flex-shrink: 0;
    background: var(--md-sys-color-outline-variant);
    border-radius: 1px;
  }
  .shelf-sep[hidden] { display: none; }

  /* ── Shelf icon wrapper — 44dp tap target ───────────────────────── */
  .shelf-icon {
    position: relative;
    display: flex; align-items: center; justify-content: center;
    width: 44px; height: 44px;
    border-radius: var(--md-sys-shape-corner-full);
    text-decoration: none;
    flex-shrink: 0;
    --state-color: var(--md-sys-color-on-surface);
  }
  .shelf-icon[hidden] { display: none; }

  /* ── White circle (Chrome OS app style) ─────────────────────────── */
  .shelf-icon__circle {
    position: relative;
    width: 40px; height: 40px;
    border-radius: var(--md-sys-shape-corner-full);
    background: #FFFFFF;
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
    box-shadow: var(--md-sys-elevation-level0);
    transition: box-shadow 150ms cubic-bezier(0.2, 0, 0, 1);
    flex-shrink: 0;
  }

  /* Per-item elevation — revealed on hover, kept while its menu is open. */
  .shelf-icon:hover .elev-1, .shelf-icon.menu-active .elev-1 { box-shadow: var(--shelf-pop-shadow-1); }
  .shelf-icon:hover .elev-2, .shelf-icon.menu-active .elev-2 { box-shadow: var(--shelf-pop-shadow-2); }
  .shelf-icon:hover .elev-3, .shelf-icon.menu-active .elev-3 { box-shadow: var(--shelf-pop-shadow-3); }

  /* ── Favicon ─────────────────────────────────────────────────────── */
  .shelf-icon__favicon {
    display: block;
    object-fit: cover;
    pointer-events: none;
  }

  /* ── Hover tooltip — reveals the shortcut name above the shelf ───────────── */
  .shelf-icon__tip {
    position: absolute;
    bottom: calc(100% + var(--shelf-gap) + (var(--shelf-height) - 44px) / 2);
    left: 50%;
    transform-origin: bottom center;
    transform: translateX(-50%) translateY(10px) scale(0.7);
    padding: 10px 18px;
    background: var(--md-sys-color-surface-container);
    color: var(--md-sys-color-on-surface);
    border-radius: var(--md-sys-shape-corner-extra-large);
