---
/**
 * Shortcuts.astro — App icon grid.
 *
 * Default shortcuts are defined below. The user can override them at runtime
 * via the edit UI, which persists to chrome.storage.local.
 * Add/remove entries from DEFAULT_SHORTCUTS or let the runtime UI manage them.
 */
---

<section class="shortcuts" id="shortcuts">
  <div class="shortcut-grid" id="shortcut-grid">
    <!-- Populated by the script below -->
  </div>
  <button class="add-shortcut" id="add-shortcut" title="Add shortcut">＋</button>
</section>

<script>
  import { storageGet, storageSet } from '../lib/storage.js';

  const DEFAULT_SHORTCUTS = [
    { label: 'Gmail',    url: 'https://mail.google.com',    emoji: '✉️' },
    { label: 'Calendar', url: 'https://calendar.google.com',emoji: '📅' },
    { label: 'GitHub',   url: 'https://github.com',         emoji: '🐙' },
    { label: 'YouTube',  url: 'https://youtube.com',        emoji: '▶️' },
    { label: 'Notion',   url: 'https://notion.so',          emoji: '📝' },
    { label: 'Figma',    url: 'https://figma.com',          emoji: '🎨' },
  ];

  async function loadShortcuts() {
    const { shortcuts } = await storageGet('shortcuts');
    return shortcuts ?? DEFAULT_SHORTCUTS;
  }

  function renderGrid(shortcuts) {
    const grid = document.getElementById('shortcut-grid');
    if (!grid) return;
    grid.innerHTML = shortcuts.map((s, i) => `
      <a class="shortcut-item" href="${s.url}" target="_blank" rel="noopener" data-index="${i}">
        <span class="shortcut-icon">${s.emoji ?? '🔗'}</span>
        <span class="shortcut-label">${s.label}</span>
      </a>
    `).join('');
  }

  loadShortcuts().then(renderGrid);
</script>

<style>
  .shortcuts {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    width: 100%;
  }

  .shortcut-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }

  .shortcut-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    width: 80px;
    padding: 12px 8px;
    background: var(--color-surface);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--color-text);
    font-size: 12px;
    transition: background 0.15s, transform 0.1s;
  }
  .shortcut-item:hover {
    background: var(--color-border);
    transform: translateY(-2px);
    color: var(--color-accent);
  }

  .shortcut-icon { font-size: 24px; line-height: 1; }
  .shortcut-label { text-align: center; line-height: 1.2; }

  .add-shortcut {
    background: none;
    border: 1.5px dashed var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
    font-size: 20px;
    width: 80px;
    height: 80px;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }
  .add-shortcut:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
</style>
