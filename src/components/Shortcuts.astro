---
/**
 * Shortcuts — Chrome OS–style circular app icons in the shelf.
 *
 * Each icon is a 40dp white circle holding the site's favicon (no labels).
 * Favicons are fetched from Google's favicon service by domain, so any URL
 * the user pins automatically gets the right icon.
 */
---

<div class="shelf-apps" id="shelf-apps" role="list" aria-label="App shortcuts">
  <!-- Populated by script -->
</div>

<script>
  import { storageGet } from '../lib/storage.js';

  const DEFAULT_SHORTCUTS = [
    { label: 'Gmail',     url: 'https://mail.google.com'     },
    { label: 'Calendar',  url: 'https://calendar.google.com' },
    { label: 'GitHub',    url: 'https://github.com'          },
    { label: 'YouTube',   url: 'https://youtube.com'         },
    { label: 'Notion',    url: 'https://notion.so'           },
    { label: 'Figma',     url: 'https://figma.com'           },
    { label: 'Linear',    url: 'https://linear.app'          },
    { label: 'Vercel',    url: 'https://vercel.com'          },
  ];

  /** Resolve a high-res favicon for a URL via Google's favicon service. */
  function faviconFor(url: string): string {
    try {
      const { hostname } = new URL(url);
      return `https://www.google.com/s2/favicons?domain=${hostname}&sz=64`;
    } catch {
      return '';
    }
  }

  async function render() {
    const { shortcuts } = await storageGet('shortcuts') as any;
    const items = shortcuts ?? DEFAULT_SHORTCUTS;
    const shelf = document.getElementById('shelf-apps');
    if (!shelf) return;

    shelf.innerHTML = items.map((s: any) => `
      <a
        class="shelf-icon md3-state-layer"
        href="${s.url}"
        target="_blank"
        rel="noopener noreferrer"
        role="listitem"
        aria-label="${s.label}"
        title="${s.label}"
      >
        <span class="shelf-icon__circle" aria-hidden="true">
          <img class="shelf-icon__favicon" src="${faviconFor(s.url)}" alt="" loading="lazy" />
        </span>
      </a>
    `).join('');
  }

  render();
</script>

<style>
  .shelf-apps {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 100%;
  }

  /* ── Shelf icon wrapper — 44dp tap target ───────────────────────── */
  .shelf-icon {
    position: relative;
    display: flex; align-items: center; justify-content: center;
    width: 44px; height: 44px;
    border-radius: var(--md-sys-shape-corner-full);
    text-decoration: none;
    flex-shrink: 0;
    --state-color: var(--md-sys-color-on-surface);
  }

  /* ── White circle holding the favicon (Chrome OS app style) ──────── */
  .shelf-icon__circle {
    width: 40px; height: 40px;
    border-radius: var(--md-sys-shape-corner-full);
    background: #FFFFFF;
    display: flex; align-items: center; justify-content: center;
    box-shadow: var(--md-sys-elevation-level1);
    transition: transform 150ms cubic-bezier(0.2, 0, 0, 1),
                box-shadow 150ms cubic-bezier(0.2, 0, 0, 1);
    flex-shrink: 0;
    overflow: hidden;
  }
  .shelf-icon:hover .shelf-icon__circle {
    transform: scale(1.12);
    box-shadow: var(--md-sys-elevation-level2);
  }

  .shelf-icon__favicon {
    width: 22px; height: 22px;
    object-fit: contain;
    pointer-events: none;
    display: block;
  }
</style>
