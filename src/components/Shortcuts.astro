---
/**
 * Shortcuts — Chrome OS–style circular app icons in the shelf.
 *
 * Each icon is a 40×40 dp circle using MD3 container colors,
 * with the app emoji centred inside. Hovering reveals a tooltip
 * above (Chrome OS shelf tooltip style).
 *
 * Container colors cycle through primary → secondary → tertiary containers
 * so adjacent icons feel differentiated yet on-palette.
 */
---

<div class="shelf-apps" id="shelf-apps" role="list" aria-label="App shortcuts">
  <!-- Populated by script -->
</div>

<script>
  import { storageGet } from '../lib/storage.js';

  const DEFAULT_SHORTCUTS = [
    { label: 'Gmail',     url: 'https://mail.google.com',     emoji: '✉️' },
    { label: 'Calendar',  url: 'https://calendar.google.com', emoji: '📅' },
    { label: 'GitHub',    url: 'https://github.com',          emoji: '🐙' },
    { label: 'YouTube',   url: 'https://youtube.com',         emoji: '▶️' },
    { label: 'Notion',    url: 'https://notion.so',           emoji: '📝' },
    { label: 'Figma',     url: 'https://figma.com',           emoji: '🎨' },
    { label: 'Linear',    url: 'https://linear.app',          emoji: '🔵' },
    { label: 'Vercel',    url: 'https://vercel.com',          emoji: '▲'  },
  ];

  // MD3 container-color classes, cycling per index
  const CONTAINER_CLASSES = [
    'icon--primary',
    'icon--secondary',
    'icon--tertiary',
    'icon--primary',
    'icon--secondary',
    'icon--tertiary',
    'icon--primary',
    'icon--secondary',
  ];

  async function render() {
    const { shortcuts } = await storageGet('shortcuts') as any;
    const items = shortcuts ?? DEFAULT_SHORTCUTS;
    const shelf = document.getElementById('shelf-apps');
    if (!shelf) return;

    shelf.innerHTML = items.map((s: any, i: number) => `
      <a
        class="shelf-icon md3-state-layer"
        href="${s.url}"
        target="_blank"
        rel="noopener noreferrer"
        role="listitem"
        aria-label="${s.label}"
      >
        <div class="shelf-icon__circle ${CONTAINER_CLASSES[i % CONTAINER_CLASSES.length]}" aria-hidden="true">
          <span class="shelf-icon__emoji">${s.emoji ?? '🔗'}</span>
        </div>
        <span class="shelf-icon__tooltip" role="tooltip">${s.label}</span>
      </a>
    `).join('');
  }

  render();
</script>

<style>
  .shelf-apps {
    display: flex;
    align-items: center;
    gap: 4px;
    height: 100%;
  }

  /* ── Shelf icon wrapper ────────────────────────────────────────── */
  /* 44×44dp tap target wrapping the 40dp circle                     */
  .shelf-icon {
    position: relative;
    display: flex; align-items: center; justify-content: center;
    width: 44px; height: 44px;
    border-radius: var(--md-sys-shape-corner-full);
    text-decoration: none;
    flex-shrink: 0;
    --state-color: var(--md-sys-color-on-surface);
  }

  /* ── Circular icon container — Chrome OS style ─────────────────── */
  /* 40dp circle, MD3 container color, elevation-level1 shadow        */
  .shelf-icon__circle {
    width: 40px; height: 40px;
    border-radius: var(--md-sys-shape-corner-full);
    display: flex; align-items: center; justify-content: center;
    /* Single MD3 level-1 shadow — not doubled with anything else */
    box-shadow: var(--md-sys-elevation-level1);
    transition: transform 150ms cubic-bezier(0.2, 0, 0, 1),
                box-shadow 150ms cubic-bezier(0.2, 0, 0, 1);
    flex-shrink: 0;
  }
  .shelf-icon:hover .shelf-icon__circle {
    transform: scale(1.12);
    box-shadow: var(--md-sys-elevation-level2);
  }

  /* Container color variants */
  .icon--primary   { background: var(--md-sys-color-primary-container); }
  .icon--secondary { background: var(--md-sys-color-secondary-container); }
  .icon--tertiary  { background: var(--md-sys-color-tertiary-container); }

  .shelf-icon__emoji {
    font-size: 20px;
    line-height: 1;
    display: flex; align-items: center;
    pointer-events: none;
  }

  /* ── Chrome OS shelf tooltip ─────────────────────────────────────── */
  .shelf-icon__tooltip {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%; transform: translateX(-50%);
    background: var(--md-sys-color-surface-container-highest);
    color: var(--md-sys-color-on-surface);
    font: var(--md-sys-typescale-label-medium);
    letter-spacing: var(--md-sys-typescale-label-medium-tracking);
    white-space: nowrap;
    padding: 4px 8px;
    border-radius: var(--md-sys-shape-corner-extra-small);
    box-shadow: var(--md-sys-elevation-level2);
    pointer-events: none;
    opacity: 0;
    transition: opacity 120ms 500ms; /* 500ms delay before appearing */
    z-index: 100;
  }
  .shelf-icon:hover .shelf-icon__tooltip { opacity: 1; }
</style>
