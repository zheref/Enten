---
/**
 * Shortcuts — MD3 Assist Chip grid.
 * spec: height 32dp, shape=full (corner-full), surfaceContainerLow bg,
 *       outline-variant border, labelLarge text, 18dp leading icon.
 *
 * Shortcuts are stored in chrome.storage.local so the user can add/remove
 * without touching source code.
 */
---

<section class="shortcuts">
  <div class="chip-grid" id="shortcut-grid" role="list">
    <!-- Populated by script -->
  </div>
</section>

<script>
  import { storageGet, storageSet } from '../lib/storage.js';

  const DEFAULT_SHORTCUTS = [
    { label: 'Gmail',     url: 'https://mail.google.com',     emoji: '✉️' },
    { label: 'Calendar',  url: 'https://calendar.google.com', emoji: '📅' },
    { label: 'GitHub',    url: 'https://github.com',          emoji: '🐙' },
    { label: 'YouTube',   url: 'https://youtube.com',         emoji: '▶️' },
    { label: 'Notion',    url: 'https://notion.so',           emoji: '📝' },
    { label: 'Figma',     url: 'https://figma.com',           emoji: '🎨' },
    { label: 'Linear',    url: 'https://linear.app',          emoji: '🔵' },
    { label: 'Vercel',    url: 'https://vercel.com',          emoji: '▲' },
  ];

  async function render() {
    const { shortcuts } = await storageGet('shortcuts');
    const items = shortcuts ?? DEFAULT_SHORTCUTS;
    const grid  = document.getElementById('shortcut-grid');
    if (!grid) return;

    grid.innerHTML = items.map((s, i) => `
      <a
        class="assist-chip md3-state-layer"
        href="${s.url}"
        target="_blank"
        rel="noopener noreferrer"
        role="listitem"
        data-index="${i}"
      >
        <span class="assist-chip__icon" aria-hidden="true">${s.emoji ?? '🔗'}</span>
        <span class="assist-chip__label">${s.label}</span>
      </a>
    `).join('');
  }

  render();
</script>

<style>
  .shortcuts { width: 100%; }

  /* ── MD3 Chip grid ───────────────────────────────────────────────── */
  .chip-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
  }

  /* ── MD3 Assist Chip ─────────────────────────────────────────────── */
  /* spec: h=32dp, shape=full, bg=surfaceContainerLow,                 */
  /*       border=1dp outline-variant, px=16dp, gap=8dp, icon=18dp     */
  .assist-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 32px;
    padding: 0 16px 0 8px;       /* leading icon needs less padding    */
    border-radius: var(--md-sys-shape-corner-full);
    background: var(--md-sys-color-surface-container-low);
    border: 1px solid var(--md-sys-color-outline-variant);
    text-decoration: none;
    color: var(--md-sys-color-on-surface);
    transition: box-shadow 200ms cubic-bezier(0.2, 0, 0, 1),
                border-color 200ms;
    --state-color: var(--md-sys-color-on-surface);  /* state layer color */
  }
  /* Elevated state on hover — MD3 chips gain elevation-1 on hover */
  .assist-chip:hover {
    box-shadow: var(--md-sys-elevation-level1);
    border-color: transparent;
  }

  .assist-chip__icon {
    font-size: 18px;
    line-height: 1;
    display: flex;
    align-items: center;
  }
  .assist-chip__label {
    font: var(--md-sys-typescale-label-large);
    letter-spacing: var(--md-sys-typescale-label-large-tracking);
  }
</style>
