---
/**
 * Shortcuts — compact shelf app icons for the bottom dock.
 *
 * Each shortcut renders as a 40×40 dp icon-only button with emoji,
 * a tooltip label, and an MD3 state layer on hover/press.
 * Tooltips appear above (Chrome OS shelf tooltip style).
 */
---

<div class="shelf-apps" id="shelf-apps" role="list" aria-label="App shortcuts">
  <!-- Populated by script -->
</div>

<script>
  import { storageGet } from '../lib/storage.js';

  const DEFAULT_SHORTCUTS = [
    { label: 'Gmail',     url: 'https://mail.google.com',     emoji: '✉️' },
    { label: 'Calendar',  url: 'https://calendar.google.com', emoji: '📅' },
    { label: 'GitHub',    url: 'https://github.com',          emoji: '🐙' },
    { label: 'YouTube',   url: 'https://youtube.com',         emoji: '▶️' },
    { label: 'Notion',    url: 'https://notion.so',           emoji: '📝' },
    { label: 'Figma',     url: 'https://figma.com',           emoji: '🎨' },
    { label: 'Linear',    url: 'https://linear.app',          emoji: '🔵' },
    { label: 'Vercel',    url: 'https://vercel.com',          emoji: '▲' },
  ];

  async function render() {
    const { shortcuts } = await storageGet('shortcuts');
    const items = shortcuts ?? DEFAULT_SHORTCUTS;
    const shelf = document.getElementById('shelf-apps');
    if (!shelf) return;

    shelf.innerHTML = items.map(s => `
      <a
        class="shelf-icon md3-state-layer"
        href="${s.url}"
        target="_blank"
        rel="noopener noreferrer"
        role="listitem"
        aria-label="${s.label}"
        data-tooltip="${s.label}"
      >
        <span class="shelf-icon__emoji" aria-hidden="true">${s.emoji ?? '🔗'}</span>
        <span class="shelf-icon__tooltip">${s.label}</span>
      </a>
    `).join('');
  }

  render();
</script>

<style>
  .shelf-apps {
    display: flex;
    align-items: center;
    gap: 2px;
    height: 100%;
  }

  /* ── Shelf icon button ──────────────────────────────────────────── */
  /* 40×40dp tap target, icon-only, full-round shape                   */
  .shelf-icon {
    position: relative;
    display: flex; align-items: center; justify-content: center;
    width: 40px; height: 40px;
    border-radius: var(--md-sys-shape-corner-medium);
    text-decoration: none;
    color: inherit;
    --state-color: var(--md-sys-color-on-surface);
    flex-shrink: 0;
  }

  .shelf-icon__emoji {
    font-size: 22px;
    line-height: 1;
    pointer-events: none;
    position: relative; z-index: 2;
  }

  /* Chrome OS-style tooltip appearing above the icon */
  .shelf-icon__tooltip {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%; transform: translateX(-50%);
    background: var(--md-sys-color-surface-container-highest);
    color: var(--md-sys-color-on-surface);
    font: var(--md-sys-typescale-label-medium);
    letter-spacing: var(--md-sys-typescale-label-medium-tracking);
    white-space: nowrap;
    padding: 4px 8px;
    border-radius: var(--md-sys-shape-corner-extra-small);
    box-shadow: var(--md-sys-elevation-level2);
    pointer-events: none;
    opacity: 0;
    transition: opacity 150ms 400ms;  /* delayed reveal */
    z-index: 100;
  }
  .shelf-icon:hover .shelf-icon__tooltip { opacity: 1; }
</style>
