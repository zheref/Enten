---
/**
 * Shortcuts — Chrome OS–style circular app icons in the shelf.
 *
 * Each icon is a 40dp circle (white background, MD3 elevation) holding the
 * site's favicon, fetched from Google's favicon service by domain.
 *
 * Per-item favicon size (the `scale` field, 0–100, percent of the circle):
 *   • 100 → favicon fills the whole circle and is clipped by the circle's
 *           rounded boundary (turns a square favicon into a round app icon).
 *           Best for favicons that ship their own square coloured background.
 *   • < 100 → favicon is scaled down proportionally and centred, leaving the
 *           white circle visible around it. Best for transparent / glyph-only
 *           favicons. e.g. 55 ≈ a small centred glyph; 75 ≈ a larger one.
 *
 * Per-item elevation (the `elevation` field, 0–3):
 *   Maps to MD3 elevation levels. Defaults to 1. Independent of `scale`.
 *
 * Both fields are configurable per shortcut and persisted in
 * chrome.storage.local under `shortcuts`.
 */
---

<div class="shelf-apps" id="shelf-apps" role="list" aria-label="App shortcuts">
  <!-- Populated by script -->
</div>

<!-- Shared right-click menu for any shelf icon (anchored in JS to the clicked one) -->
<md-menu id="app-context-menu" positioning="fixed" y-offset="16" anchor-corner="start-start" menu-corner="end-start">
  <md-menu-item id="ctx-newtab">
    <div slot="headline">Open in New Tab</div>
    <svg slot="start" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3z"/>
    </svg>
  </md-menu-item>
  <md-menu-item id="ctx-thistab">
    <div slot="headline">Open in This Tab</div>
    <svg slot="start" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M19 4H5c-1.11 0-2 .9-2 2v12c0 1.1.89 2 2 2h4v-2H5V8h14v10h-4v2h4c1.1 0 2-.9 2-2V6c0-1.1-.89-2-2-2zm-7 6l-4 4h3v6h2v-6h3z"/>
    </svg>
  </md-menu-item>
  <md-menu-item id="ctx-copy">
    <div slot="headline">Copy Link</div>
    <svg slot="start" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11z"/>
    </svg>
  </md-menu-item>
  <!-- Bookmarks only — toggled in JS -->
  <md-menu-item id="ctx-adjust">
    <div slot="headline">Adjust Containment</div>
    <svg slot="start" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M3 17v2h6v-2H3zM3 5v2h10V5H3zm10 16v-2h8v-2h-8v-2h-2v6h2zM7 9v2H3v2h4v2h2V9H7zm14 4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z"/>
    </svg>
  </md-menu-item>
</md-menu>

<script>
  import { storageGet } from '../lib/storage.js';
  import { showSnackbar } from '../lib/snackbar.js';

  // scale: 0–100 (percent of circle)  ·  elevation: 0 | 1 | 2 | 3
  const DEFAULT_SHORTCUTS = [
    { label: 'Gmail',    url: 'https://mail.google.com',     scale: 80, elevation: 1 },
    { label: 'Calendar', url: 'https://calendar.google.com', scale: 80, elevation: 1 },
    { label: 'GitHub',   url: 'https://github.com',          scale: 73,  elevation: 1 },
    { label: 'YouTube',  url: 'https://youtube.com',         scale: 67, elevation: 1 },
    { label: 'Notion',   url: 'https://notion.so',           scale: 73,  elevation: 1 },
    { label: 'Figma',    url: 'https://figma.com',           scale: 67,  elevation: 1 },
    { label: 'Linear',   url: 'https://linear.app',          scale: 90, elevation: 1 },
    { label: 'Vercel',   url: 'https://vercel.com',          scale: 100,  elevation: 1 },
  ];

  /** Resolve a high-res favicon for a URL via Google's favicon service. */
  function faviconFor(url: string): string {
    try {
      const { hostname } = new URL(url);
      return `https://www.google.com/s2/favicons?domain=${hostname}&sz=64`;
    } catch {
      return '';
    }
  }

  const clamp = (n: number, lo: number, hi: number) => Math.max(lo, Math.min(hi, n));
  const esc = (s: string) => String(s).replace(/[&<>"]/g, c =>
    ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));

  /** Build one shelf icon.
   *  kind: 'shortcut' (fixed) | 'bookmark' (overridable via Adjust Containment).
   *  bg:   optional circle background override (hex). */
  function iconHTML(item: any, scaleDefault = 100, elevDefault = 1,
                    kind = 'shortcut', bg = ''): string {
    const scale = clamp(typeof item.scale === 'number' ? item.scale : scaleDefault, 0, 100);
    const elev  = [0, 1, 2, 3].includes(item.elevation) ? item.elevation : elevDefault;
    const label = esc(item.label ?? item.url ?? '');
    const bgStyle = bg ? `background:${esc(bg)};` : '';
    // No target=_blank: a normal click opens in THIS tab. New-tab / copy are
    // available from the right-click menu (and middle-click still opens a tab).
    return `
      <a class="shelf-icon" href="${esc(item.url)}" role="listitem" aria-label="${label}"
         data-url="${esc(item.url)}" data-kind="${kind}">
        <span class="shelf-icon__circle elev-${elev}" style="${bgStyle}" aria-hidden="true">
          <img class="shelf-icon__favicon" style="width:${scale}%;height:${scale}%"
               src="${faviconFor(item.url)}" alt="" loading="lazy" />
        </span>
        <span class="shelf-icon__tip" role="tooltip">${label}</span>
      </a>`;
  }

  /** Read the Chrome Bookmarks Bar (node id "1"); bookmarks only (skip folders). */
  async function getBookmarksBar(): Promise<{ label: string; url: string }[]> {
    if (typeof chrome === 'undefined' || !chrome?.bookmarks) return [];
    return new Promise(resolve => {
      chrome.bookmarks.getChildren('1', (children: any[]) => {
        if (chrome.runtime.lastError || !children) { resolve([]); return; }
        resolve(children
          .filter(n => n.url)
          .map(n => ({ label: n.title || n.url, url: n.url })));
      });
    });
  }

  async function render() {
    const shelf = document.getElementById('shelf-apps');
    if (!shelf) return;

    // 1) Configured shortcuts (storage override → defaults) — fixed, not adjustable
    const { shortcuts } = await storageGet('shortcuts') as any;
    const items = shortcuts ?? DEFAULT_SHORTCUTS;
    let html = items.map((s: any) => iconHTML(s, 100, 1, 'shortcut')).join('');

    // 2) Separator + Chrome Bookmarks Bar — overridable via Adjust Containment
    const bookmarks = await getBookmarksBar();
    if (bookmarks.length) {
      const { bookmarkOverrides = {} } = await storageGet('bookmarkOverrides') as any;
      html += '<span class="shelf-sep" aria-hidden="true"></span>';
      html += bookmarks.map(b => {
        const ov = bookmarkOverrides[b.url] || {};
        const scale = typeof ov.scale === 'number' ? ov.scale : 85;
        return iconHTML({ ...b, scale }, 85, 1, 'bookmark', ov.bg || '');
      }).join('');
    }

    shelf.innerHTML = html;
  }

  // Allow other components (the containment adjuster) to force a re-render.
  window.addEventListener('shelf-icons-refresh', () => { render(); });

  // ── Right-click context menu (shared, re-anchored per icon) ─────────────────
  let ctxUrl = '';
  let ctxKind = 'shortcut';
  let ctxLabel = '';

  function setupContextMenu() {
    const shelf = document.getElementById('shelf-apps');
    const menu  = document.getElementById('app-context-menu') as any;
    const adjustItem = document.getElementById('ctx-adjust') as HTMLElement;
    if (!shelf || !menu) return;

    // Open our menu instead of the browser's on right-click of an icon.
    shelf.addEventListener('contextmenu', (e: MouseEvent) => {
      const icon = (e.target as HTMLElement).closest('.shelf-icon') as HTMLElement | null;
      if (!icon) return;
      e.preventDefault();
      ctxUrl   = icon.getAttribute('href') || '';
      ctxKind  = icon.dataset.kind || 'shortcut';
      ctxLabel = icon.getAttribute('aria-label') || '';
      // "Adjust Containment" applies to bookmark-fetched apps only.
      if (adjustItem) adjustItem.style.display = ctxKind === 'bookmark' ? '' : 'none';
      menu.anchorElement = icon;
      // Hide the tooltip first, then reveal the menu once it has faded out.
      shelf.classList.add('menu-open');
      setTimeout(() => { menu.open = true; }, 120);
    });
    // Let tooltips return once the menu is dismissed.
    menu.addEventListener('closed', () => shelf.classList.remove('menu-open'));

    document.getElementById('ctx-newtab')?.addEventListener('click', () => {
      if (ctxUrl) window.open(ctxUrl, '_blank');
    });
    document.getElementById('ctx-thistab')?.addEventListener('click', () => {
      if (ctxUrl) window.location.href = ctxUrl;
    });
    document.getElementById('ctx-copy')?.addEventListener('click', async () => {
      if (!ctxUrl) return;
      try {
        await navigator.clipboard.writeText(ctxUrl);
        showSnackbar('Link copied to clipboard');
      } catch (err) {
        showSnackbar('Couldn’t copy link');
        console.error('[SergioSwift] Copy link failed', err);
      }
    });
    document.getElementById('ctx-adjust')?.addEventListener('click', () => {
      if (ctxKind !== 'bookmark' || !ctxUrl) return;
      window.dispatchEvent(new CustomEvent('open-containment', {
        detail: { url: ctxUrl, label: ctxLabel, favicon: faviconFor(ctxUrl) },
      }));
    });
  }

  render();
  setupContextMenu();
</script>

<!-- is:global — shelf icons are injected at runtime via innerHTML, which never
     receives Astro's scoped [data-astro-cid-*] attribute. Scoped rules would
     not match those nodes, so these (shelf-unique) classes must be global. -->
<style is:global>
  :root {
    /* Shared "pop" shadow — used by the shelf tooltips AND the hover-revealed
       icon elevation. Drop shadow + light glow (so it highlights on dark
       wallpapers too). Level 2 == the tooltip. Original (narrow) blur radii.
       LIGHT MODE: the drop is lightened via a lighter COLOUR (grey), not a thin
       alpha — tweak --shelf-shadow-color to taste. */
    --shelf-shadow-color: 150, 150, 150;
    --shelf-pop-shadow-1: 0 4px 14px rgba(var(--shelf-shadow-color), 0.24), 0 0 12px rgba(255, 255, 255, 0.18);
    --shelf-pop-shadow-2: 0 8px 24px rgba(var(--shelf-shadow-color), 0.28), 0 0 18px rgba(255, 255, 255, 0.22);
    --shelf-pop-shadow-3: 0 12px 32px rgba(var(--shelf-shadow-color), 0.32), 0 0 26px rgba(255, 255, 255, 0.26);
  }
  /* DARK MODE: black drop (original radii). */
  .dark-scheme {
    --shelf-shadow-color: 0, 0, 0;
    --shelf-pop-shadow-1: 0 4px 14px rgba(var(--shelf-shadow-color), 0.30), 0 0 12px rgba(255, 255, 255, 0.20);
    --shelf-pop-shadow-2: 0 8px 24px rgba(var(--shelf-shadow-color), 0.34), 0 0 18px rgba(255, 255, 255, 0.24);
    --shelf-pop-shadow-3: 0 12px 32px rgba(var(--shelf-shadow-color), 0.38), 0 0 26px rgba(255, 255, 255, 0.28);
  }

  .shelf-apps {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 100%;
  }

  /* Divider between the configured shortcuts and the Chrome bookmarks */
  .shelf-sep {
    width: 1px;
    height: 24px;
    margin: 0 4px;
    flex-shrink: 0;
    background: var(--md-sys-color-outline-variant);
    border-radius: 1px;
  }

  /* ── Shelf icon wrapper — 44dp tap target ───────────────────────── */
  .shelf-icon {
    position: relative;
    display: flex; align-items: center; justify-content: center;
    width: 44px; height: 44px;
    border-radius: var(--md-sys-shape-corner-full);
    text-decoration: none;
    flex-shrink: 0;
    --state-color: var(--md-sys-color-on-surface);
  }

  /* ── White circle (Chrome OS app style) ─────────────────────────── */
  /* Always clips its content to a circle via overflow:hidden, so a
     100%-scale favicon is rounded; centres any smaller favicon.       */
  .shelf-icon__circle {
    position: relative;
    width: 40px; height: 40px;
    border-radius: var(--md-sys-shape-corner-full);
    background: #FFFFFF;
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
    /* Flat by default — elevation is revealed on hover (no zoom). */
    box-shadow: var(--md-sys-elevation-level0);
    transition: box-shadow 150ms cubic-bezier(0.2, 0, 0, 1);
    flex-shrink: 0;
  }

  /* ── Per-item elevation — revealed only on hover ─────────────────── */
  /* At rest every circle is elevation-less; hovering one lifts just it.
     Uses the same shadow colour as the tooltips (dark drop + light glow). */
  .shelf-icon:hover .elev-1 { box-shadow: var(--shelf-pop-shadow-1); }
  .shelf-icon:hover .elev-2 { box-shadow: var(--shelf-pop-shadow-2); }
  .shelf-icon:hover .elev-3 { box-shadow: var(--shelf-pop-shadow-3); }

  /* ── Favicon ─────────────────────────────────────────────────────── */
  /* Size comes from an inline width/height percentage (the `scale` field).
     object-fit: cover means a 100% favicon fills the circle edge-to-edge
     (then clipped round); a smaller one is centred by the flex container. */
  .shelf-icon__favicon {
    display: block;
    object-fit: cover;
    pointer-events: none;
    transform-origin: center;
    transition: transform 520ms cubic-bezier(0.2, 0, 0, 1);
  }
  /* Zoom the favicon ~10% on hover (clipped by the circle's overflow:hidden) */
  .shelf-icon:hover .shelf-icon__favicon { transform: scale(1.1); }

  /* ── Hover tooltip — reveals the shortcut name above the shelf ─────────────
     Styled to match the menus: same corner radius (extra-large) and the same
     elevation (level 2) on a surface-container background. */
  .shelf-icon__tip {
    position: absolute;
    bottom: calc(100% + 16px);         /* more gap between tooltip and the bar */
    left: 50%;
    /* Grows from the bar: starts small + lower, scaling from its bottom edge */
    transform-origin: bottom center;
    transform: translateX(-50%) translateY(10px) scale(0.7);
    padding: 10px 18px;
    background: var(--md-sys-color-surface-container);
    color: var(--md-sys-color-on-surface);
    border-radius: var(--md-sys-shape-corner-extra-large); /* same as menus */
    /* Same "pop" shadow shared with the hover-revealed icon elevation. */
    box-shadow: var(--shelf-pop-shadow-2);
    font: var(--md-sys-typescale-title-small);
    letter-spacing: var(--md-sys-typescale-title-small-tracking);
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity 140ms ease,
                transform 200ms cubic-bezier(0.2, 0, 0, 1);
    z-index: 50;
  }
  .shelf-icon:hover .shelf-icon__tip,
  .shelf-icon:focus-visible .shelf-icon__tip {
    opacity: 1;
    transform: translateX(-50%) translateY(0) scale(1);
    transition-delay: 200ms;           /* brief delay before revealing */
  }
  /* While the right-click menu is open, hide tooltips immediately (no delay)
     so the tooltip disappears before the menu appears, and returns after. */
  .shelf-apps.menu-open .shelf-icon__tip {
    opacity: 0;
    transform: translateX(-50%) translateY(10px) scale(0.7);
    transition: opacity 100ms ease, transform 100ms ease;
    transition-delay: 0ms;
  }
</style>
