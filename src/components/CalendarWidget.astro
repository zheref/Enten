---
/**
 * CalendarWidget — MD3 Elevated Card, desktop floating style.
 * Glass-surface: semi-transparent surfaceContainerLow + backdrop blur.
 * Contains a card header + 2-line list of upcoming events.
 */
---

<div class="md3-card--elevated">
  <div class="card-header">
    <span class="card-header__icon" aria-hidden="true">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
        <path d="M20 3h-1V1h-2v2H7V1H5v2H4c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 18H4V8h16v13z"/>
      </svg>
    </span>
    <span class="card-header__title">Upcoming</span>
    <button class="icon-btn md3-state-layer" id="cal-refresh" aria-label="Refresh calendar">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.65 6.35A7.958 7.958 0 0 0 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/>
      </svg>
    </button>
  </div>

  <ul class="md3-list" id="event-list" role="list">
    <li class="list-item--placeholder">Loading…</li>
  </ul>
</div>

<script>
  import { getUpcomingEvents } from '../lib/google.js';
  import { storageGet, storageSet } from '../lib/storage.js';

  function fmtTime(iso) {
    try {
      return new Date(iso).toLocaleString(undefined, {
        weekday: 'short', month: 'short', day: 'numeric',
        hour: '2-digit', minute: '2-digit',
      });
    } catch { return iso; }
  }

  function render(events) {
    const list = document.getElementById('event-list');
    if (!list) return;
    if (!events.length) {
      list.innerHTML = '<li class="list-item--placeholder">No upcoming events</li>';
      return;
    }
    list.innerHTML = events.map(e => `
      <li class="md3-list-item md3-list-item--two-line md3-state-layer">
        <div class="list-item__leading list-item__leading--primary" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67V7z"/>
          </svg>
        </div>
        <div class="list-item__content">
          <span class="list-item__headline">${e.title}</span>
          <span class="list-item__supporting">
            ${e.allDay ? 'All day' : fmtTime(e.start)}${e.location ? ` · ${e.location}` : ''}
          </span>
        </div>
      </li>
    `).join('');
  }

  async function load(force = false) {
    const { cachedEvents } = await storageGet('cachedEvents');
    if (cachedEvents) render(cachedEvents);
    if (!force && cachedEvents) return;
    try {
      const events = await getUpcomingEvents(8);
      await storageSet({ cachedEvents: events });
      render(events);
    } catch (err) {
      const list = document.getElementById('event-list');
      const cached = await storageGet('cachedEvents').then(r => r.cachedEvents);
      if (list && !cached) {
        list.innerHTML = `<li class="list-item--placeholder list-item--error">⚠ ${err.message}</li>`;
      }
    }
  }

  load();
  document.getElementById('cal-refresh')?.addEventListener('click', () => load(true));
</script>

<style>
  /* ── Floating desktop card — glass surface treatment ────────────── */
  .md3-card--elevated {
    display: flex; flex-direction: column;
    background: color-mix(in srgb, var(--md-sys-color-surface-container-low) 85%, transparent);
    backdrop-filter: blur(16px) saturate(1.6);
    -webkit-backdrop-filter: blur(16px) saturate(1.6);
    border-radius: var(--md-sys-shape-corner-large);
    box-shadow: var(--md-sys-elevation-level2);
    border: 1px solid color-mix(in srgb, var(--md-sys-color-outline-variant) 60%, transparent);
    padding: 12px 0 8px;
    height: 100%;
    overflow: hidden;
  }

  /* Card header */
  .card-header {
    display: flex; align-items: center; gap: 8px;
    padding: 0 16px 10px;
    border-bottom: 1px solid var(--md-sys-color-outline-variant);
    margin-bottom: 4px;
  }
  .card-header__icon { color: var(--md-sys-color-primary); display: flex; }
  .card-header__title {
    flex: 1;
    font: var(--md-sys-typescale-title-medium);
    letter-spacing: var(--md-sys-typescale-title-medium-tracking);
    color: var(--md-sys-color-on-surface);
  }

  /* MD3 Icon button */
  .icon-btn {
    display: flex; align-items: center; justify-content: center;
    width: 40px; height: 40px;
    border-radius: var(--md-sys-shape-corner-full);
    border: none; background: transparent;
    color: var(--md-sys-color-on-surface-variant); cursor: pointer;
    --state-color: var(--md-sys-color-on-surface-variant);
    transition: color 200ms;
  }
  .icon-btn:hover { color: var(--md-sys-color-on-surface); }

  /* MD3 List */
  .md3-list {
    list-style: none;
    display: flex; flex-direction: column;
    overflow-y: auto; flex: 1;
  }

  /* MD3 Two-line list item — spec: h=72dp */
  .md3-list-item {
    display: flex; align-items: center; gap: 16px;
    min-height: 64px; padding: 8px 16px;
    color: inherit;
    --state-color: var(--md-sys-color-on-surface);
  }

  /* 40dp leading avatar container */
  .list-item__leading {
    flex-shrink: 0;
    width: 40px; height: 40px;
    border-radius: var(--md-sys-shape-corner-full);
    display: flex; align-items: center; justify-content: center;
  }
  .list-item__leading--primary {
    background: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
  }
  .list-item__leading--secondary {
    background: var(--md-sys-color-secondary-container);
    color: var(--md-sys-color-on-secondary-container);
  }

  .list-item__content {
    flex: 1; display: flex; flex-direction: column; gap: 2px; min-width: 0;
  }
  .list-item__headline {
    font: var(--md-sys-typescale-body-large);
    letter-spacing: var(--md-sys-typescale-body-large-tracking);
    color: var(--md-sys-color-on-surface);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .list-item__supporting {
    font: var(--md-sys-typescale-body-medium);
    letter-spacing: var(--md-sys-typescale-body-medium-tracking);
    color: var(--md-sys-color-on-surface-variant);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }

  .list-item--placeholder {
    padding: 16px;
    font: var(--md-sys-typescale-body-medium);
    color: var(--md-sys-color-on-surface-variant);
  }
  .list-item--error { color: var(--md-sys-color-error); }
</style>
