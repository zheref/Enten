---
/**
 * CalendarWidget — official MD3 components.
 *   <md-elevated-card>  → canonical elevation (shadow + surface tint)
 *   <md-list>/<md-list-item> → MD3 list with built-in ripple & typography
 *   <md-icon-button>    → refresh action
 *   <md-filled-button>  → sign-in CTA in the empty state
 *
 * The header is the drag handle ([data-drag-handle]).
 */
---

<md-elevated-card class="md3-card">

  <!-- Header / drag handle -->
  <div class="card-header" data-drag-handle>
    <span class="card-header__icon" aria-hidden="true">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
        <path d="M20 3h-1V1h-2v2H7V1H5v2H4c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 18H4V8h16v13z"/>
      </svg>
    </span>
    <span class="card-header__title">Upcoming</span>
    <md-icon-button id="cal-refresh" aria-label="Refresh calendar">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.65 6.35A7.958 7.958 0 0 0 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/>
      </svg>
    </md-icon-button>
  </div>

  <!-- List / empty state -->
  <md-list id="event-list" class="md3-list">
    <div class="placeholder">Loading…</div>
  </md-list>

</md-elevated-card>

<script>
  import { getUpcomingEvents } from '../lib/google.js';
  import { storageGet, storageSet } from '../lib/storage.js';

  const listEl = () => document.getElementById('event-list');

  function fmtTime(iso: string) {
    try {
      return new Date(iso).toLocaleString(undefined, {
        weekday: 'short', month: 'short', day: 'numeric',
        hour: '2-digit', minute: '2-digit',
      });
    } catch { return iso; }
  }

  function esc(s: string) {
    return String(s).replace(/[&<>"]/g, c =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));
  }

  function renderEvents(events: any[]) {
    const list = listEl(); if (!list) return;
    if (!events.length) {
      list.innerHTML = '<div class="placeholder">No upcoming events</div>';
      return;
    }
    list.innerHTML = events.map((e: any) => `
      <md-list-item type="text">
        <div slot="start" class="leading leading--primary" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zm.01 18c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67V7z"/>
          </svg>
        </div>
        <div slot="headline">${esc(e.title)}</div>
        <div slot="supporting-text">${e.allDay ? 'All day' : esc(fmtTime(e.start))}${e.location ? ' · ' + esc(e.location) : ''}</div>
      </md-list-item>
    `).join('');
  }

  function renderAuthCTA() {
    const list = listEl(); if (!list) return;
    list.innerHTML = `
      <div class="empty-state">
        <div class="empty-state__icon" aria-hidden="true">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20 3h-1V1h-2v2H7V1H5v2H4c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 18H4V8h16v13z"/>
          </svg>
        </div>
        <p class="empty-state__headline">No calendar connected</p>
        <p class="empty-state__body">Sign in with Google to see your upcoming events here.</p>
        <md-filled-button id="cal-signin">Sign in with Google</md-filled-button>
      </div>
    `;
    document.getElementById('cal-signin')?.addEventListener('click', triggerAuth);
  }

  async function triggerAuth() {
    if (typeof chrome === 'undefined' || !chrome?.identity) return;
    try {
      const token = await new Promise<string>((res, rej) =>
        chrome.identity.getAuthToken({ interactive: true }, (t: string) =>
          chrome.runtime.lastError ? rej(new Error(chrome.runtime.lastError.message)) : res(t)
        )
      );
      const profile = await fetch(
        'https://www.googleapis.com/oauth2/v1/userinfo?alt=json',
        { headers: { Authorization: `Bearer ${token}` } }
      ).then(r => r.json());
      await storageSet({ userEmail: profile.email });
      location.reload();
    } catch (e) { console.error('[SergioSwift] Auth', e); }
  }

  async function load(force = false) {
    const { cachedEvents } = await storageGet('cachedEvents') as any;
    if (cachedEvents) renderEvents(cachedEvents);
    if (!force && cachedEvents) return;
    try {
      const events = await getUpcomingEvents(8);
      await storageSet({ cachedEvents: events });
      renderEvents(events);
    } catch {
      const cached = await storageGet('cachedEvents').then((r: any) => r.cachedEvents);
      if (!cached) renderAuthCTA();
    }
  }

  load();
  document.getElementById('cal-refresh')?.addEventListener('click', () => load(true));
</script>

<style>
  /* ── Card host ──────────────────────────────────────────────────────
     md-elevated-card supplies canonical MD3 elevation (shadow + surface
     tint, auto-tonal in dark). We only lay out its slotted children.   */
  .md3-card {
    display: flex; flex-direction: column;
    height: 100%;
    overflow: hidden;
    --md-elevated-card-container-shape: var(--md-sys-shape-corner-large);
  }

  /* Header — also the drag handle */
  .card-header {
    display: flex; align-items: center; gap: 8px;
    padding: 8px 8px 8px 16px;
    border-bottom: 1px solid var(--md-sys-color-outline-variant);
    user-select: none;
    flex-shrink: 0;
  }
  .card-header__icon { color: var(--md-sys-color-primary); display: flex; }
  .card-header__title {
    flex: 1;
    font: var(--md-sys-typescale-title-medium);
    letter-spacing: var(--md-sys-typescale-title-medium-tracking);
    color: var(--md-sys-color-on-surface);
  }
  #cal-refresh { color: var(--md-sys-color-on-surface-variant); }

  /* MD3 List — transparent so the card surface shows through */
  .md3-list {
    flex: 1; overflow-y: auto; padding: 8px;
    --md-list-container-color: transparent;
  }

  /* NOTE: .leading / .empty-state* / .placeholder live in the global MD3
     component layer (theme.css) because they're injected at runtime. */
</style>
