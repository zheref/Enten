---
/**
 * ContainmentAdjuster — "Customize Icon": floating, closeable & collapsible
 * card to tune any shelf app's icon source/resolution, containment scale, and
 * circle background colour.
 *
 * Opened via the `open-containment` window event (from the shelf right-click
 * menu). Edits persist to chrome.storage.local under `appOverrides` keyed by
 * URL, applied live to the shelf icon. Reuses the global .widget-card chrome.
 */
---

<md-elevated-card class="widget-card expanded containment-card is-hidden" id="containment-card">
  <div class="widget-card__clip">

    <div class="widget-card__header">
      <span class="widget-card__icon" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M3 17v2h6v-2H3zM3 5v2h10V5H3zm10 16v-2h8v-2h-8v-2h-2v6h2zM7 9v2H3v2h4v2h2V9H7zm14 4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z"/>
        </svg>
      </span>
      <span class="widget-card__title">Customize Icon</span>
      <md-icon-button class="widget-toggle" id="ct-toggle" aria-label="Collapse">
        <svg class="chevron" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 8l-6 6 1.41 1.41L12 10.83l4.59 4.58L18 14z"/>
        </svg>
      </md-icon-button>
      <md-icon-button id="ct-close" aria-label="Close">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
        </svg>
      </md-icon-button>
    </div>

    <div class="widget-card__body">
      <div class="widget-card__body-inner">
        <div class="ct-content">

          <!-- Live preview with nudge arrows to move the icon within the circle -->
          <div class="ct-preview">
            <div class="ct-nudge">
              <md-icon-button class="ct-arrow ct-arrow--up" data-dx="0" data-dy="-1" aria-label="Move up">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M7.41 15.41L12 10.83l4.59 4.58L18 14l-6-6-6 6z"/></svg>
              </md-icon-button>
              <md-icon-button class="ct-arrow ct-arrow--left" data-dx="-1" data-dy="0" aria-label="Move left">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M15.41 16.59L10.83 12l4.58-4.59L14 6l-6 6 6 6z"/></svg>
              </md-icon-button>
              <span class="shelf-icon__circle elev-1 ct-preview__circle" id="ct-circle" aria-hidden="true">
                <img class="shelf-icon__favicon" id="ct-img" alt="" />
              </span>
              <md-icon-button class="ct-arrow ct-arrow--right" data-dx="1" data-dy="0" aria-label="Move right">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6z"/></svg>
              </md-icon-button>
              <md-icon-button class="ct-arrow ct-arrow--down" data-dx="0" data-dy="1" aria-label="Move down">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6z"/></svg>
              </md-icon-button>
            </div>
            <span class="ct-preview__label" id="ct-label"></span>
          </div>

          <!-- Icon source / resolution picker (last tile is a + to add a custom URL) -->
          <div class="ct-field">
            <div class="ct-field__label"><span>Icon</span></div>
            <div class="ct-icons" id="ct-icons" role="list"><!-- populated by script --></div>
            <div class="ct-custom is-hidden" id="ct-custom">
              <input type="url" id="ct-custom-url" class="ct-custom__input" spellcheck="false"
                     placeholder="Paste image URL (PNG, JPG, ICO)" />
              <button type="button" id="ct-custom-use" class="ct-custom__use">Use</button>
            </div>
          </div>

          <!-- Containment scale -->
          <div class="ct-field">
            <div class="ct-field__label">
              <span>Containment scale</span>
              <span class="ct-field__value" id="ct-scale-val">85%</span>
            </div>
            <md-slider id="ct-scale" min="0" max="100" step="1" value="85" labeled></md-slider>
          </div>

          <!-- Circle background: label on the left, controls on the right -->
          <div class="ct-field ct-field--row">
            <div class="ct-field__label"><span>Circle background</span></div>
            <div class="ct-bg-controls">
              <label class="ct-swatch" id="ct-swatch" title="Pick a colour">
                <input type="color" id="ct-color" value="#ffffff" />
              </label>
              <div class="ct-bg-buttons">
                <md-icon-button id="ct-pick" title="Pick from screen" aria-label="Pick from screen">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M17.66 5.41l.92.92-2.69 2.69-.92-.92 2.69-2.69M17.67 3c-.26 0-.51.1-.71.29l-3.12 3.12-1.93-1.91-1.41 1.41 1.42 1.42L3 16.25V21h4.75l8.92-8.92 1.42 1.42 1.41-1.41-1.92-1.92 3.12-3.12c.4-.4.4-1.03.01-1.42l-2.34-2.34c-.2-.19-.45-.29-.7-.29zM6.92 19L5 17.08l8.06-8.06 1.92 1.92L6.92 19z"/>
                  </svg>
                </md-icon-button>
                <md-icon-button id="ct-reset" title="Reset" aria-label="Reset">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M13 3a9 9 0 0 0-9 9H1l3.89 3.89.07.14L9 12H6c0-3.87 3.13-7 7-7s7 3.13 7 7-3.13 7-7 7c-1.93 0-3.68-.79-4.94-2.06l-1.42 1.42A8.954 8.954 0 0 0 13 21a9 9 0 0 0 0-18z"/>
                  </svg>
                </md-icon-button>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>

  </div>
</md-elevated-card>

<script>
  import { storageGet, storageSet } from '../lib/storage.js';
  import { showSnackbar } from '../lib/snackbar.js';
  import { faviconFor, iconSources } from '../lib/favicons.js';

  const card    = document.getElementById('containment-card') as HTMLElement;
  const img     = document.getElementById('ct-img') as HTMLImageElement;
  const circle  = document.getElementById('ct-circle') as HTMLElement;
  const labelEl = document.getElementById('ct-label') as HTMLElement;
  const slider  = document.getElementById('ct-scale') as any;
  const scaleVal= document.getElementById('ct-scale-val') as HTMLElement;
  const colorIn = document.getElementById('ct-color') as HTMLInputElement;
  const swatch  = document.getElementById('ct-swatch') as HTMLElement;
  const iconsEl = document.getElementById('ct-icons') as HTMLElement;
  const customRow = document.getElementById('ct-custom') as HTMLElement;
  const customUrl = document.getElementById('ct-custom-url') as HTMLInputElement;

  const clamp = (n: number, lo: number, hi: number) => Math.max(lo, Math.min(hi, n));
  const esc = (s: string) => String(s).replace(/[&<>"]/g, c =>
    ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));

  const NUDGE_STEP = 2;   // px per arrow tap
  const NUDGE_MAX  = 20;  // px clamp (≈ half the shelf circle)

  let url = '';
  let scale = 85;
  let bg = '#ffffff';
  let chosenIcon = '';            // explicit icon override ('' = use the default favicon)
  let defaultIcon = '';           // the icon shown when no override
  let offset = { x: 0, y: 0 };    // manual position nudge within the circle (px)
  let saveTimer: number | undefined;

  const offsetStyle = () => (offset.x || offset.y) ? `translate(${offset.x}px,${offset.y}px)` : '';

  const effectiveIcon = () => chosenIcon || defaultIcon;

  function findShelfIcon(): HTMLElement | null {
    return Array.from(document.querySelectorAll('.shelf-icon'))
      .find(a => (a as HTMLElement).dataset.url === url) as HTMLElement | null;
  }

  function applyPreview() {
    img.style.width = scale + '%';
    img.style.height = scale + '%';
    img.style.transform = offsetStyle();
    img.src = effectiveIcon();
    circle.style.background = bg;
    swatch.style.background = bg;        // the swatch shows the chosen colour, full-bleed
  }
  function applyToShelf() {
    const icon = findShelfIcon(); if (!icon) return;
    const i = icon.querySelector('.shelf-icon__favicon') as HTMLElement | null;
    const c = icon.querySelector('.shelf-icon__circle') as HTMLElement | null;
    if (i) {
      i.style.width = scale + '%'; i.style.height = scale + '%';
      i.style.transform = offsetStyle();
      if (chosenIcon) i.setAttribute('src', chosenIcon);
    }
    if (c) c.style.background = bg;
  }
  function persistDebounced() {
    if (saveTimer) clearTimeout(saveTimer);
    saveTimer = window.setTimeout(async () => {
      const { appOverrides = {} } = await storageGet('appOverrides') as any;
      const entry: any = { scale, bg };
      if (chosenIcon) entry.icon = chosenIcon;
      if (offset.x || offset.y) entry.offset = { x: offset.x, y: offset.y };
      appOverrides[url] = entry;
      await storageSet({ appOverrides });
    }, 200);
  }
  function update() { applyPreview(); applyToShelf(); persistDebounced(); }

  // Render the candidate icon sources, highlighting the effective one. A custom
  // URL (one not among the built-in sources) gets its own tile, and the trailing
  // "+" tile reveals the custom-URL field.
  function renderIcons() {
    const selected = effectiveIcon();
    const sources = iconSources(url);
    const isCustom = !!chosenIcon && !sources.some(c => c.src === chosenIcon);
    let html = sources.map(c => `
      <button class="ct-icon ${c.src === selected ? 'is-selected' : ''}" data-src="${esc(c.src)}"
              role="listitem" title="${esc(c.label)}" aria-label="${esc(c.label)}">
        <img src="${esc(c.src)}" alt="" loading="lazy" />
      </button>`).join('');
    if (isCustom) {
      html += `
        <button class="ct-icon is-selected" data-src="${esc(chosenIcon)}"
                role="listitem" title="Custom URL" aria-label="Custom icon">
          <img src="${esc(chosenIcon)}" alt="" loading="lazy" />
        </button>`;
    }
    html += `
      <button class="ct-icon ct-icon--add" data-add="1" title="Custom URL…" aria-label="Add a custom icon URL">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
      </button>`;
    iconsEl.innerHTML = html;
  }

  iconsEl?.addEventListener('click', (e: MouseEvent) => {
    const target = e.target as HTMLElement;
    const add = target.closest('.ct-icon--add') as HTMLElement | null;
    if (add) {
      const hidden = customRow.classList.toggle('is-hidden');
      if (!hidden) { customUrl.value = ''; customUrl.focus(); }
      return;
    }
    const btn = target.closest('.ct-icon') as HTMLElement | null;
    if (!btn) return;
    chosenIcon = btn.dataset.src || '';
    iconsEl.querySelectorAll('.ct-icon').forEach(b => b.classList.toggle('is-selected', b === btn));
    update();
  });

  // Apply a typed/pasted custom image URL as the icon.
  function applyCustomUrl() {
    const v = customUrl.value.trim();
    if (!v) return;
    try { new URL(v); } catch { showSnackbar('Enter a valid image URL'); return; }
    chosenIcon = v;
    customRow.classList.add('is-hidden');
    renderIcons();
    update();
  }
  document.getElementById('ct-custom-use')?.addEventListener('click', applyCustomUrl);
  customUrl?.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Enter') { e.preventDefault(); applyCustomUrl(); }
  });

  // Nudge arrows — move the icon within the circle (works for any source).
  card.querySelectorAll('.ct-arrow').forEach(btn => {
    btn.addEventListener('click', () => {
      const el = btn as HTMLElement;
      const dx = Number(el.dataset.dx) || 0;
      const dy = Number(el.dataset.dy) || 0;
      offset.x = clamp(offset.x + dx * NUDGE_STEP, -NUDGE_MAX, NUDGE_MAX);
      offset.y = clamp(offset.y + dy * NUDGE_STEP, -NUDGE_MAX, NUDGE_MAX);
      update();
    });
  });

  // ── Open from the shelf right-click menu ────────────────────────────────────
  window.addEventListener('open-containment', async (e: any) => {
    const detail = e.detail || {};
    url = detail.url || '';
    if (!url) return;
    const { appOverrides = {} } = await storageGet('appOverrides') as any;
    const ov = appOverrides[url] || {};
    scale = typeof ov.scale === 'number' ? ov.scale : (typeof detail.scale === 'number' ? detail.scale : 85);
    bg = ov.bg || '#ffffff';
    chosenIcon = ov.icon || '';
    defaultIcon = detail.icon || faviconFor(url);
    offset = (ov.offset && typeof ov.offset.x === 'number')
      ? { x: ov.offset.x, y: ov.offset.y } : { x: 0, y: 0 };
    customRow.classList.add('is-hidden');

    labelEl.textContent = detail.label || url;
    slider.value = scale;
    scaleVal.textContent = scale + '%';
    colorIn.value = /^#[0-9a-f]{6}$/i.test(bg) ? bg : '#ffffff';
    applyPreview();
    renderIcons();

    card.classList.remove('is-hidden');
    card.classList.add('expanded');
  });

  // ── Controls ────────────────────────────────────────────────────────────────
  slider?.addEventListener('input', () => {
    scale = clamp(Number(slider.value) || 0, 0, 100);
    scaleVal.textContent = scale + '%';
    update();
  });

  colorIn?.addEventListener('input', () => { bg = colorIn.value; update(); });

  document.getElementById('ct-pick')?.addEventListener('click', async () => {
    if (!('EyeDropper' in window)) { showSnackbar('Eyedropper not supported in this browser'); return; }
    try {
      const result = await new (window as any).EyeDropper().open();
      bg = result.sRGBHex;
      colorIn.value = bg;
      update();
    } catch { /* user cancelled */ }
  });

  document.getElementById('ct-reset')?.addEventListener('click', async () => {
    const { appOverrides = {} } = await storageGet('appOverrides') as any;
    delete appOverrides[url];
    await storageSet({ appOverrides });
    bg = '#ffffff'; chosenIcon = ''; offset = { x: 0, y: 0 };
    colorIn.value = '#ffffff';
    customRow.classList.add('is-hidden');
    applyPreview();
    renderIcons();
    window.dispatchEvent(new CustomEvent('shelf-icons-refresh')); // restore defaults on the shelf
    showSnackbar('Icon reset');
  });

  document.getElementById('ct-close')?.addEventListener('click', () => {
    card.classList.add('is-hidden');
  });

  // Collapse / expand (no persistence needed for this transient panel)
  const toggle = document.getElementById('ct-toggle');
  toggle?.addEventListener('click', () => {
    const expanded = card.classList.toggle('expanded');
    toggle.setAttribute('aria-label', expanded ? 'Collapse' : 'Expand');
  });
  // Enable transitions after first paint (consistent with the other cards).
  requestAnimationFrame(() => card.classList.add('anim-ready'));
</script>

<style is:global>
  /* Floating panel above the shelf, horizontally centred. */
  .containment-card {
    position: fixed;
    left: 50%;
    bottom: var(--shelf-clearance);
    transform: translateX(-50%);
    width: 340px;
    max-width: calc(100vw - 32px);
    z-index: 40;                       /* above the shelf (20) */
  }
  .containment-card.is-hidden { display: none !important; }

  .ct-content { display: flex; flex-direction: column; gap: 18px; padding: 16px; }

  /* Preview */
  .ct-preview { display: flex; flex-direction: column; align-items: center; gap: 8px; }
  /* Circle centred, with nudge arrows around it (cross layout). */
  .ct-nudge {
    display: grid;
    grid-template-columns: auto auto auto;
    grid-template-rows: auto auto auto;
    align-items: center; justify-items: center;
    gap: 2px;
  }
  .ct-arrow--up    { grid-area: 1 / 2 / 2 / 3; }
  .ct-arrow--left  { grid-area: 2 / 1 / 3 / 2; }
  .ct-nudge .ct-preview__circle { grid-area: 2 / 2 / 3 / 3; }
  .ct-arrow--right { grid-area: 2 / 3 / 3 / 4; }
  .ct-arrow--down  { grid-area: 3 / 2 / 4 / 3; }
  .ct-arrow {
    width: 32px; height: 32px;
    --md-icon-button-icon-size: 20px;
    --md-icon-button-icon-color: var(--md-sys-color-on-surface-variant);
  }
  /* Higher specificity so it wins over the single-class .shelf-icon__circle */
  .containment-card .ct-preview__circle {
    width: 64px; height: 64px;
    box-shadow: var(--shelf-pop-shadow-1);
  }
  .ct-preview__label {
    font: var(--md-sys-typescale-label-large);
    letter-spacing: var(--md-sys-typescale-label-large-tracking);
    color: var(--md-sys-color-on-surface-variant);
    max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }

  /* Fields */
  .ct-field { display: flex; flex-direction: column; gap: 4px; }
  /* Row variant: label on the left, controls pushed to the far right */
  .ct-field--row {
    flex-direction: row; align-items: center; justify-content: space-between; gap: 12px;
  }
  .ct-field__label {
    display: flex; justify-content: space-between; align-items: baseline;
    font: var(--md-sys-typescale-body-medium);
    letter-spacing: var(--md-sys-typescale-body-medium-tracking);
    color: var(--md-sys-color-on-surface);
  }
  .ct-field__value { color: var(--md-sys-color-primary); font-weight: 500; }
  .containment-card md-slider { width: 100%; }

  /* Icon source / resolution picker */
  .ct-icons { display: flex; flex-wrap: wrap; gap: 8px; }
  .ct-icon {
    width: 44px; height: 44px; padding: 7px;
    flex-shrink: 0;
    border: 2px solid transparent;
    border-radius: var(--md-sys-shape-corner-medium);
    background: #ffffff;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: border-color 150ms ease, box-shadow 150ms ease;
  }
  .ct-icon:hover { box-shadow: var(--md-sys-elevation-level1); }
  .ct-icon.is-selected { border-color: var(--md-sys-color-primary); }
  .ct-icon img { width: 100%; height: 100%; object-fit: contain; }

  /* "+" tile to add a custom URL */
  .ct-icon--add {
    background: transparent;
    border: 2px dashed var(--md-sys-color-outline-variant);
    color: var(--md-sys-color-on-surface-variant);
  }
  .ct-icon--add:hover {
    border-color: var(--md-sys-color-primary);
    color: var(--md-sys-color-primary);
    box-shadow: none;
  }

  /* Custom-URL field, revealed by the "+" tile */
  .ct-custom { display: flex; align-items: center; gap: 8px; margin-top: 8px; }
  .ct-custom.is-hidden { display: none; }
  .ct-custom__input {
    flex: 1; min-width: 0; height: 40px; padding: 0 12px;
    font: var(--md-sys-typescale-body-medium);
    letter-spacing: var(--md-sys-typescale-body-medium-tracking);
    color: var(--md-sys-color-on-surface);
    background: var(--md-sys-color-surface-container-highest);
    border: 1px solid var(--md-sys-color-outline);
    border-radius: var(--md-sys-shape-corner-small);
    outline: none;
    transition: border-color 150ms ease;
  }
  .ct-custom__input::placeholder { color: var(--md-sys-color-on-surface-variant); }
  .ct-custom__input:focus { border-color: var(--md-sys-color-primary); border-width: 2px; padding: 0 11px; }
  .ct-custom__use {
    flex-shrink: 0; height: 40px; padding: 0 18px;
    border: none; border-radius: var(--md-sys-shape-corner-full);
    background: var(--md-sys-color-secondary-container);
    color: var(--md-sys-color-on-secondary-container);
    font: var(--md-sys-typescale-label-large);
    letter-spacing: var(--md-sys-typescale-label-large-tracking);
    cursor: pointer;
    transition: box-shadow 150ms ease;
  }
  .ct-custom__use:hover { box-shadow: var(--md-sys-elevation-level1); }

  /* Background controls: swatch + a vertical stack of icon buttons on its right */
  .ct-bg-controls { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }

  /* Colour swatch — the chosen colour fills the whole circle */
  .ct-swatch {
    width: 44px; height: 44px; flex-shrink: 0;
    border-radius: var(--md-sys-shape-corner-full);
    border: 1px solid var(--md-sys-color-outline-variant);
    background: #ffffff;                 /* set to the chosen colour in JS */
    overflow: hidden; cursor: pointer; position: relative;
  }
  .ct-swatch input[type="color"] {
    position: absolute; inset: 0; width: 100%; height: 100%;
    opacity: 0; border: none; padding: 0; cursor: pointer;
  }

  .ct-bg-buttons { display: flex; flex-direction: column; }
  .ct-bg-buttons md-icon-button {
    width: 32px; height: 32px;
    --md-icon-button-icon-size: 18px;
  }
</style>
