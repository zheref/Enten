---
/**
 * EmailWidget — MD3 Elevated Card, desktop floating style.
 * Glass-surface: semi-transparent surfaceContainerLow + backdrop blur.
 * Contains a card header + 3-line list of inbox messages.
 * Unread indicator: primary-colored headline + leading avatar.
 */
---

<div class="md3-card--elevated">
  <div class="card-header">
    <span class="card-header__icon" aria-hidden="true">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
        <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
      </svg>
    </span>
    <span class="card-header__title">Inbox</span>
    <button class="icon-btn md3-state-layer" id="email-refresh" aria-label="Refresh inbox">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.65 6.35A7.958 7.958 0 0 0 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/>
      </svg>
    </button>
  </div>

  <ul class="md3-list" id="email-list" role="list">
    <li class="list-item--placeholder">Loading…</li>
  </ul>
</div>

<script>
  import { getRecentEmails } from '../lib/google.js';
  import { storageGet, storageSet } from '../lib/storage.js';

  function displayName(from) {
    const m = from.match(/^"?([^"<]+)"?\s*(?:<.*>)?$/);
    return (m ? m[1] : from).trim();
  }
  function initial(from) { return displayName(from).charAt(0).toUpperCase() || '?'; }

  function render(emails) {
    const list = document.getElementById('email-list');
    if (!list) return;
    if (!emails.length) {
      list.innerHTML = '<li class="list-item--placeholder">Inbox is empty</li>';
      return;
    }
    list.innerHTML = emails.map(e => `
      <li class="md3-list-item md3-list-item--three-line md3-state-layer ${e.unread ? 'unread' : ''}">
        <div class="list-item__leading ${e.unread ? 'list-item__leading--primary' : 'list-item__leading--secondary'}" aria-hidden="true">
          ${initial(e.from)}
        </div>
        <div class="list-item__content">
          <span class="list-item__overline">${displayName(e.from)}</span>
          <span class="list-item__headline">${e.subject}</span>
          <span class="list-item__supporting">${e.snippet}</span>
        </div>
        ${e.unread ? '<span class="unread-badge" aria-label="Unread"></span>' : ''}
      </li>
    `).join('');
  }

  async function load(force = false) {
    const { cachedEmails } = await storageGet('cachedEmails');
    if (cachedEmails) render(cachedEmails);
    if (!force && cachedEmails) return;
    try {
      const emails = await getRecentEmails(8);
      await storageSet({ cachedEmails: emails });
      render(emails);
    } catch (err) {
      const list = document.getElementById('email-list');
      const cached = await storageGet('cachedEmails').then(r => r.cachedEmails);
      if (list && !cached) {
        list.innerHTML = `<li class="list-item--placeholder list-item--error">⚠ ${err.message}</li>`;
      }
    }
  }

  load();
  document.getElementById('email-refresh')?.addEventListener('click', () => load(true));
</script>

<style>
  /* Glass surface card — same treatment as CalendarWidget */
  .md3-card--elevated {
    display: flex; flex-direction: column;
    background: color-mix(in srgb, var(--md-sys-color-surface-container-low) 85%, transparent);
    backdrop-filter: blur(16px) saturate(1.6);
    -webkit-backdrop-filter: blur(16px) saturate(1.6);
    border-radius: var(--md-sys-shape-corner-large);
    box-shadow: var(--md-sys-elevation-level2);
    border: 1px solid color-mix(in srgb, var(--md-sys-color-outline-variant) 60%, transparent);
    padding: 12px 0 8px;
    height: 100%;
    overflow: hidden;
  }

  .card-header {
    display: flex; align-items: center; gap: 8px;
    padding: 0 16px 10px;
    border-bottom: 1px solid var(--md-sys-color-outline-variant);
    margin-bottom: 4px;
  }
  .card-header__icon { color: var(--md-sys-color-primary); display: flex; }
  .card-header__title {
    flex: 1;
    font: var(--md-sys-typescale-title-medium);
    letter-spacing: var(--md-sys-typescale-title-medium-tracking);
    color: var(--md-sys-color-on-surface);
  }
  .icon-btn {
    display: flex; align-items: center; justify-content: center;
    width: 40px; height: 40px;
    border-radius: var(--md-sys-shape-corner-full);
    border: none; background: transparent;
    color: var(--md-sys-color-on-surface-variant); cursor: pointer;
    --state-color: var(--md-sys-color-on-surface-variant);
    transition: color 200ms;
  }
  .icon-btn:hover { color: var(--md-sys-color-on-surface); }

  .md3-list {
    list-style: none;
    display: flex; flex-direction: column;
    overflow-y: auto; flex: 1;
  }

  /* MD3 Three-line list item — spec: h=88dp */
  .md3-list-item {
    display: flex; align-items: flex-start; gap: 16px;
    min-height: 80px; padding: 10px 16px;
    position: relative; color: inherit;
    --state-color: var(--md-sys-color-on-surface);
  }

  /* Monogram avatar */
  .list-item__leading {
    flex-shrink: 0;
    width: 40px; height: 40px; margin-top: 2px;
    border-radius: var(--md-sys-shape-corner-full);
    display: flex; align-items: center; justify-content: center;
    font: var(--md-sys-typescale-title-small);
  }
  .list-item__leading--primary {
    background: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
  }
  .list-item__leading--secondary {
    background: var(--md-sys-color-secondary-container);
    color: var(--md-sys-color-on-secondary-container);
  }

  .list-item__content {
    flex: 1; display: flex; flex-direction: column; gap: 1px; min-width: 0;
  }

  /* Overline — sender name */
  .list-item__overline {
    font: var(--md-sys-typescale-label-small);
    letter-spacing: var(--md-sys-typescale-label-small-tracking);
    color: var(--md-sys-color-on-surface-variant);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }

  /* Headline — subject */
  .list-item__headline {
    font: var(--md-sys-typescale-body-large);
    letter-spacing: var(--md-sys-typescale-body-large-tracking);
    color: var(--md-sys-color-on-surface);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .md3-list-item.unread .list-item__headline {
    color: var(--md-sys-color-primary);
    font-weight: 500;
  }

  /* Supporting — snippet */
  .list-item__supporting {
    font: var(--md-sys-typescale-body-medium);
    letter-spacing: var(--md-sys-typescale-body-medium-tracking);
    color: var(--md-sys-color-on-surface-variant);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }

  /* Unread indicator dot */
  .unread-badge {
    flex-shrink: 0;
    width: 8px; height: 8px;
    border-radius: var(--md-sys-shape-corner-full);
    background: var(--md-sys-color-primary);
    align-self: center; margin-left: auto;
  }

  .list-item--placeholder {
    padding: 16px;
    font: var(--md-sys-typescale-body-medium);
    color: var(--md-sys-color-on-surface-variant);
  }
  .list-item--error { color: var(--md-sys-color-error); }
</style>
