---
/**
 * EmailWidget — MD3 Elevated Card, desktop floating style.
 * Same shadow/surface rules as CalendarWidget.
 * Card header = drag handle ([data-drag-handle]).
 * Empty state with Sign-in CTA when auth is needed.
 */
---

<div class="md3-card">

  <div class="card-header" data-drag-handle>
    <span class="card-header__icon" aria-hidden="true">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
        <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
      </svg>
    </span>
    <span class="card-header__title">Inbox</span>
    <button class="icon-btn md3-state-layer" id="email-refresh" aria-label="Refresh inbox">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.65 6.35A7.958 7.958 0 0 0 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/>
      </svg>
    </button>
  </div>

  <ul class="md3-list" id="email-list" role="list">
    <li class="placeholder">Loading…</li>
  </ul>

</div>

<script>
  import { getRecentEmails } from '../lib/google.js';
  import { storageGet, storageSet } from '../lib/storage.js';

  const listEl = () => document.getElementById('email-list');

  function displayName(from: string) {
    const m = from.match(/^"?([^"<]+)"?\s*(?:<.*>)?$/);
    return (m ? m[1] : from).trim();
  }
  const initial = (from: string) => displayName(from).charAt(0).toUpperCase() || '?';

  function renderEmails(emails: any[]) {
    const list = listEl(); if (!list) return;
    if (!emails.length) {
      list.innerHTML = '<li class="placeholder">Inbox is empty</li>';
      return;
    }
    list.innerHTML = emails.map((e: any) => `
      <li class="md3-list-item md3-state-layer ${e.unread ? 'unread' : ''}">
        <div class="leading ${e.unread ? 'leading--primary' : 'leading--secondary'}" aria-hidden="true">
          ${initial(e.from)}
        </div>
        <div class="item-content">
          <span class="item-overline">${displayName(e.from)}</span>
          <span class="item-headline">${e.subject}</span>
          <span class="item-supporting">${e.snippet}</span>
        </div>
        ${e.unread ? '<span class="unread-dot" aria-label="Unread"></span>' : ''}
      </li>
    `).join('');
  }

  function renderAuthCTA() {
    const list = listEl(); if (!list) return;
    list.innerHTML = `
      <li class="empty-state">
        <div class="empty-state__icon" aria-hidden="true">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
          </svg>
        </div>
        <p class="empty-state__headline">No inbox connected</p>
        <p class="empty-state__body">Sign in with Google to preview your latest messages here.</p>
        <button class="md3-btn--filled" id="email-signin">Sign in with Google</button>
      </li>
    `;
    document.getElementById('email-signin')?.addEventListener('click', triggerAuth);
  }

  async function triggerAuth() {
    if (typeof chrome === 'undefined' || !chrome?.identity) return;
    try {
      const token = await new Promise<string>((res, rej) =>
        chrome.identity.getAuthToken({ interactive: true }, (t: string) =>
          chrome.runtime.lastError ? rej(new Error(chrome.runtime.lastError.message)) : res(t)
        )
      );
      const profile = await fetch(
        'https://www.googleapis.com/oauth2/v1/userinfo?alt=json',
        { headers: { Authorization: `Bearer ${token}` } }
      ).then(r => r.json());
      await storageSet({ userEmail: profile.email });
      location.reload();
    } catch (e) { console.error('[SergioSwift] Auth', e); }
  }

  async function load(force = false) {
    const { cachedEmails } = await storageGet('cachedEmails') as any;
    if (cachedEmails) renderEmails(cachedEmails);
    if (!force && cachedEmails) return;
    try {
      const emails = await getRecentEmails(8);
      await storageSet({ cachedEmails: emails });
      renderEmails(emails);
    } catch {
      const cached = await storageGet('cachedEmails').then((r: any) => r.cachedEmails);
      if (!cached) renderAuthCTA();
    }
  }

  load();
  document.getElementById('email-refresh')?.addEventListener('click', () => load(true));
</script>

<style>
  /* ── MD3 Elevated Card ──────────────────────────────────────────────
     Single shadow definition, no backdrop-filter (avoids doubling).
     Dark mode overrides to tonal surface + no shadow.               */
  .md3-card {
    display: flex; flex-direction: column;
    height: 100%;
    background: var(--md-sys-color-surface-container-low);
    border-radius: var(--md-sys-shape-corner-large);
    box-shadow: var(--md-sys-elevation-level1);
    overflow: hidden;
  }
  :global(.dark-scheme) .md3-card {
    background: var(--md-sys-color-surface-container-high);
    box-shadow: none;
  }

  .card-header {
    display: flex; align-items: center; gap: 8px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--md-sys-color-outline-variant);
    user-select: none; flex-shrink: 0;
  }
  .card-header__icon { color: var(--md-sys-color-primary); display: flex; }
  .card-header__title {
    flex: 1;
    font: var(--md-sys-typescale-title-medium);
    letter-spacing: var(--md-sys-typescale-title-medium-tracking);
    color: var(--md-sys-color-on-surface);
  }
  .icon-btn {
    display: flex; align-items: center; justify-content: center;
    width: 40px; height: 40px;
    border-radius: var(--md-sys-shape-corner-full);
    border: none; background: transparent;
    color: var(--md-sys-color-on-surface-variant); cursor: pointer;
    --state-color: var(--md-sys-color-on-surface-variant);
    transition: color 200ms;
  }
  .icon-btn:hover { color: var(--md-sys-color-on-surface); }

  .md3-list { list-style: none; display: flex; flex-direction: column; overflow-y: auto; flex: 1; }

  /* MD3 Three-line list item — 88dp min-height */
  .md3-list-item {
    display: flex; align-items: flex-start; gap: 16px;
    min-height: 80px; padding: 10px 16px;
    position: relative; color: inherit;
    --state-color: var(--md-sys-color-on-surface);
  }

  /* 40dp monogram avatar */
  .leading {
    flex-shrink: 0; width: 40px; height: 40px; margin-top: 2px;
    border-radius: var(--md-sys-shape-corner-full);
    display: flex; align-items: center; justify-content: center;
    font: var(--md-sys-typescale-title-small);
  }
  .leading--primary  { background: var(--md-sys-color-primary-container);   color: var(--md-sys-color-on-primary-container); }
  .leading--secondary{ background: var(--md-sys-color-secondary-container); color: var(--md-sys-color-on-secondary-container); }

  .item-content { flex: 1; display: flex; flex-direction: column; gap: 1px; min-width: 0; }

  .item-overline {
    font: var(--md-sys-typescale-label-small);
    letter-spacing: var(--md-sys-typescale-label-small-tracking);
    color: var(--md-sys-color-on-surface-variant);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .item-headline {
    font: var(--md-sys-typescale-body-large);
    letter-spacing: var(--md-sys-typescale-body-large-tracking);
    color: var(--md-sys-color-on-surface);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .unread .item-headline { color: var(--md-sys-color-primary); font-weight: 500; }
  .item-supporting {
    font: var(--md-sys-typescale-body-medium);
    letter-spacing: var(--md-sys-typescale-body-medium-tracking);
    color: var(--md-sys-color-on-surface-variant);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }

  .unread-dot {
    flex-shrink: 0; width: 8px; height: 8px;
    border-radius: var(--md-sys-shape-corner-full);
    background: var(--md-sys-color-primary);
    align-self: center; margin-left: auto;
  }

  /* ── MD3 Empty state ────────────────────────────────────────────── */
  .empty-state {
    display: flex; flex-direction: column; align-items: center;
    justify-content: center; gap: 8px;
    padding: 32px 24px; flex: 1; text-align: center;
    list-style: none;
  }
  .empty-state__icon { color: var(--md-sys-color-on-surface-variant); margin-bottom: 4px; }
  .empty-state__headline {
    font: var(--md-sys-typescale-title-medium);
    letter-spacing: var(--md-sys-typescale-title-medium-tracking);
    color: var(--md-sys-color-on-surface);
  }
  .empty-state__body {
    font: var(--md-sys-typescale-body-medium);
    letter-spacing: var(--md-sys-typescale-body-medium-tracking);
    color: var(--md-sys-color-on-surface-variant);
    max-width: 220px;
  }

  /* MD3 Filled Button */
  .md3-btn--filled {
    display: inline-flex; align-items: center; justify-content: center;
    height: 40px; padding: 0 24px; margin-top: 8px;
    border-radius: var(--md-sys-shape-corner-full);
    border: none;
    background: var(--md-sys-color-primary);
    color: var(--md-sys-color-on-primary);
    font: var(--md-sys-typescale-label-large);
    letter-spacing: var(--md-sys-typescale-label-large-tracking);
    cursor: pointer; transition: box-shadow 200ms;
    box-shadow: var(--md-sys-elevation-level1);
  }
  .md3-btn--filled:hover { box-shadow: var(--md-sys-elevation-level2); }

  .placeholder {
    padding: 16px;
    font: var(--md-sys-typescale-body-medium);
    color: var(--md-sys-color-on-surface-variant);
  }
</style>
