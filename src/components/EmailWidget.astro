---
/**
 * EmailWidget — official MD3 components (mirrors CalendarWidget).
 * Uses md-list-item slots: overline (sender), headline (subject),
 * supporting-text (snippet), start (monogram avatar), end (unread dot).
 * Header is the drag handle.
 */
---

<md-elevated-card class="md3-card">

  <div class="card-header" data-drag-handle>
    <span class="card-header__icon" aria-hidden="true">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
        <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
      </svg>
    </span>
    <span class="card-header__title">Inbox</span>
    <md-icon-button id="email-refresh" aria-label="Refresh inbox">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.65 6.35A7.958 7.958 0 0 0 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/>
      </svg>
    </md-icon-button>
  </div>

  <md-list id="email-list" class="md3-list">
    <div class="placeholder">Loading…</div>
  </md-list>

</md-elevated-card>

<script>
  import { getRecentEmails } from '../lib/google.js';
  import { storageGet, storageSet } from '../lib/storage.js';

  const listEl = () => document.getElementById('email-list');

  function displayName(from: string) {
    const m = from.match(/^"?([^"<]+)"?\s*(?:<.*>)?$/);
    return (m ? m[1] : from).trim();
  }
  const initial = (from: string) => displayName(from).charAt(0).toUpperCase() || '?';

  function esc(s: string) {
    return String(s).replace(/[&<>"]/g, c =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));
  }

  function renderEmails(emails: any[]) {
    const list = listEl(); if (!list) return;
    if (!emails.length) {
      list.innerHTML = '<div class="placeholder">Inbox is empty</div>';
      return;
    }
    list.innerHTML = emails.map((e: any) => `
      <md-list-item type="text" class="${e.unread ? 'unread' : ''}">
        <div slot="start" class="leading ${e.unread ? 'leading--primary' : 'leading--secondary'}" aria-hidden="true">
          ${esc(initial(e.from))}
        </div>
        <div slot="overline">${esc(displayName(e.from))}</div>
        <div slot="headline">${esc(e.subject)}</div>
        <div slot="supporting-text">${esc(e.snippet)}</div>
        ${e.unread ? '<div slot="end" class="unread-dot" aria-label="Unread"></div>' : ''}
      </md-list-item>
    `).join('');
  }

  function renderAuthCTA() {
    const list = listEl(); if (!list) return;
    list.innerHTML = `
      <div class="empty-state">
        <div class="empty-state__icon" aria-hidden="true">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
          </svg>
        </div>
        <p class="empty-state__headline">No inbox connected</p>
        <p class="empty-state__body">Sign in with Google to preview your latest messages here.</p>
        <md-filled-button id="email-signin">Sign in with Google</md-filled-button>
      </div>
    `;
    document.getElementById('email-signin')?.addEventListener('click', triggerAuth);
  }

  async function triggerAuth() {
    if (typeof chrome === 'undefined' || !chrome?.identity) return;
    try {
      const token = await new Promise<string>((res, rej) =>
        chrome.identity.getAuthToken({ interactive: true }, (t: string) =>
          chrome.runtime.lastError ? rej(new Error(chrome.runtime.lastError.message)) : res(t)
        )
      );
      const profile = await fetch(
        'https://www.googleapis.com/oauth2/v1/userinfo?alt=json',
        { headers: { Authorization: `Bearer ${token}` } }
      ).then(r => r.json());
      await storageSet({ userEmail: profile.email });
      location.reload();
    } catch (e) { console.error('[SergioSwift] Auth', e); }
  }

  async function load(force = false) {
    const { cachedEmails } = await storageGet('cachedEmails') as any;
    if (cachedEmails) renderEmails(cachedEmails);
    if (!force && cachedEmails) return;
    try {
      const emails = await getRecentEmails(8);
      await storageSet({ cachedEmails: emails });
      renderEmails(emails);
    } catch {
      const cached = await storageGet('cachedEmails').then((r: any) => r.cachedEmails);
      if (!cached) renderAuthCTA();
    }
  }

  load();
  document.getElementById('email-refresh')?.addEventListener('click', () => load(true));
</script>

<style>
  .md3-card {
    display: flex; flex-direction: column;
    height: 100%;
    overflow: hidden;
    --md-elevated-card-container-shape: var(--md-sys-shape-corner-large);
  }
  .card-header {
    display: flex; align-items: center; gap: 8px;
    padding: 8px 8px 8px 16px;
    border-bottom: 1px solid var(--md-sys-color-outline-variant);
    user-select: none; flex-shrink: 0;
  }
  .card-header__icon { color: var(--md-sys-color-primary); display: flex; }
  .card-header__title {
    flex: 1;
    font: var(--md-sys-typescale-title-medium);
    letter-spacing: var(--md-sys-typescale-title-medium-tracking);
    color: var(--md-sys-color-on-surface);
  }
  #email-refresh { color: var(--md-sys-color-on-surface-variant); }

  .md3-list {
    flex: 1; overflow-y: auto; padding: 8px;
    --md-list-container-color: transparent;
  }

  /* Unread subject highlight (md-list-item headline slot) */
  .unread { --md-list-item-label-text-color: var(--md-sys-color-primary); }
</style>
