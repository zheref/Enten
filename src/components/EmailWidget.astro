---
/**
 * EmailWidget — MD3 Elevated Card containing a 3-line List.
 *
 * List item spec (3-line): h=88dp, leading=40dp monogram avatar,
 *   overline=labelSmall, headline=bodyLarge, supporting=bodyMedium.
 * Unread items: headline in primary colour; avatar in primaryContainer.
 */
---

<div class="md3-card--elevated">
  <div class="card-header">
    <span class="card-header__title">Inbox</span>
    <button class="icon-btn md3-state-layer" id="email-refresh" title="Refresh" aria-label="Refresh inbox">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.65 6.35A7.958 7.958 0 0 0 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/>
      </svg>
    </button>
  </div>

  <ul class="md3-list" id="email-list" role="list">
    <li class="list-item--placeholder">Loading…</li>
  </ul>
</div>

<script>
  import { getRecentEmails } from '../lib/google.js';
  import { storageGet, storageSet } from '../lib/storage.js';

  /** Extract the "First Last" part from "First Last <email@x.com>" */
  function displayName(from) {
    const m = from.match(/^"?([^"<]+)"?\s*(?:<.*>)?$/);
    return (m ? m[1] : from).trim();
  }

  /** Single uppercase initial for the monogram avatar */
  function initial(from) {
    return displayName(from).charAt(0).toUpperCase() || '?';
  }

  function render(emails) {
    const list = document.getElementById('email-list');
    if (!list) return;
    if (!emails.length) {
      list.innerHTML = '<li class="list-item--placeholder">Inbox is empty</li>';
      return;
    }
    list.innerHTML = emails.map(e => `
      <li class="md3-list-item md3-list-item--three-line md3-state-layer ${e.unread ? 'md3-list-item--unread' : ''}">
        <!-- Monogram avatar (secondary container; primary container when unread) -->
        <div class="list-item__leading ${e.unread ? 'list-item__leading--unread' : 'list-item__leading--email'}" aria-hidden="true">
          ${initial(e.from)}
        </div>
        <div class="list-item__content">
          <span class="list-item__overline">${displayName(e.from)}</span>
          <span class="list-item__headline">${e.subject}</span>
          <span class="list-item__supporting">${e.snippet}</span>
        </div>
        ${e.unread ? '<span class="unread-dot" aria-label="Unread"></span>' : ''}
      </li>
    `).join('');
  }

  async function load(force = false) {
    const { cachedEmails } = await storageGet('cachedEmails');
    if (cachedEmails) render(cachedEmails);
    if (!force && cachedEmails) return;
    try {
      const emails = await getRecentEmails(8);
      await storageSet({ cachedEmails: emails });
      render(emails);
    } catch (err) {
      const list = document.getElementById('email-list');
      if (list && !await storageGet('cachedEmails').then(r => r.cachedEmails)) {
        list.innerHTML = `<li class="list-item--placeholder list-item--error">⚠ ${err.message}</li>`;
      }
    }
  }

  load();
  document.getElementById('email-refresh')?.addEventListener('click', () => load(true));
</script>

<style>
  /* Elevated card — shared spec (duplicated here so each component is self-contained) */
  .md3-card--elevated {
    display: flex; flex-direction: column;
    background: var(--md-sys-color-surface-container-low);
    border-radius: var(--md-sys-shape-corner-large);
    box-shadow: var(--md-sys-elevation-level1);
    padding: 16px 0 8px;
    height: 100%;
    overflow: hidden;
  }
  .card-header {
    display: flex; align-items: center;
    padding: 0 16px 8px; gap: 4px;
  }
  .card-header__title {
    flex: 1;
    font: var(--md-sys-typescale-title-medium);
    letter-spacing: var(--md-sys-typescale-title-medium-tracking);
    color: var(--md-sys-color-on-surface);
  }
  .icon-btn {
    display: flex; align-items: center; justify-content: center;
    width: 48px; height: 48px;
    border-radius: var(--md-sys-shape-corner-full);
    border: none; background: transparent;
    color: var(--md-sys-color-on-surface-variant);
    cursor: pointer;
    --state-color: var(--md-sys-color-on-surface-variant);
    transition: color 200ms;
  }
  .icon-btn:hover { color: var(--md-sys-color-on-surface); }

  .md3-list {
    list-style: none;
    display: flex; flex-direction: column;
    overflow-y: auto; flex: 1;
  }

  /* ── MD3 Three-line List Item ────────────────────────────────────── */
  /* spec: h=88dp, leading=40dp, px=16dp, gap=16dp                     */
  .md3-list-item {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    min-height: 88px;
    padding: 12px 16px;
    color: inherit;
    --state-color: var(--md-sys-color-on-surface);
    position: relative;
  }

  /* Monogram avatar */
  .list-item__leading {
    flex-shrink: 0;
    width: 40px; height: 40px;
    border-radius: var(--md-sys-shape-corner-full);
    display: flex; align-items: center; justify-content: center;
    font: var(--md-sys-typescale-title-medium);
    letter-spacing: 0;
    margin-top: 2px;
  }
  .list-item__leading--email {
    background: var(--md-sys-color-secondary-container);
    color: var(--md-sys-color-on-secondary-container);
  }
  .list-item__leading--unread {
    background: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
  }

  .list-item__content {
    flex: 1; display: flex; flex-direction: column; gap: 1px; min-width: 0;
  }

  /* Overline (sender name) — labelSmall */
  .list-item__overline {
    font: var(--md-sys-typescale-label-small);
    letter-spacing: var(--md-sys-typescale-label-small-tracking);
    color: var(--md-sys-color-on-surface-variant);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }

  /* Headline (subject) */
  .list-item__headline {
    font: var(--md-sys-typescale-body-large);
    letter-spacing: var(--md-sys-typescale-body-large-tracking);
    color: var(--md-sys-color-on-surface);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .md3-list-item--unread .list-item__headline {
    color: var(--md-sys-color-primary);  /* Giants Orange tonal — unread highlight */
    font-weight: 500;
  }

  /* Supporting text (snippet) */
  .list-item__supporting {
    font: var(--md-sys-typescale-body-medium);
    letter-spacing: var(--md-sys-typescale-body-medium-tracking);
    color: var(--md-sys-color-on-surface-variant);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }

  /* Unread indicator dot (trailing) */
  .unread-dot {
    flex-shrink: 0;
    width: 8px; height: 8px;
    border-radius: var(--md-sys-shape-corner-full);
    background: var(--md-sys-color-primary);
    align-self: center;
    margin-left: auto;
  }

  /* Placeholder */
  .list-item--placeholder {
    padding: 16px;
    font: var(--md-sys-typescale-body-medium);
    color: var(--md-sys-color-on-surface-variant);
  }
  .list-item--error { color: var(--md-sys-color-error); }
</style>
