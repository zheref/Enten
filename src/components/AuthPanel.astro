---
/**
 * AuthPanel — MD3 Outlined Button (signed-out) + Input Chip (signed-in).
 *
 * Outlined button spec: h=40dp, shape=full, border=1dp outline,
 *   px=24dp, labelLarge, no bg.
 *
 * Input chip spec: h=32dp, shape=full, leading=20dp avatar,
 *   border=1dp outline-variant, labelLarge.
 */
---

<div class="auth-panel" id="auth-panel">
  <!-- Shown when signed out -->
  <button
    class="md3-btn--outlined md3-state-layer"
    id="auth-btn"
    data-state="signed-out"
  >
    Connect Google account
  </button>

  <!-- Shown when signed in (replaced via JS) -->
</div>

<script>
  import { signOut } from '../lib/google.js';
  import { storageGet, storageSet, storageRemove } from '../lib/storage.js';

  const panel = document.getElementById('auth-panel');
  const btn   = document.getElementById('auth-btn');

  async function checkAuth() {
    const { userEmail } = await storageGet('userEmail');
    if (userEmail && panel) {
      // Replace button with an Input Chip showing the account
      panel.innerHTML = `
        <div class="input-chip md3-state-layer" id="account-chip" role="button" tabindex="0" title="Sign out">
          <div class="input-chip__avatar" aria-hidden="true">
            ${userEmail.charAt(0).toUpperCase()}
          </div>
          <span class="input-chip__label">${userEmail}</span>
          <button class="input-chip__delete md3-state-layer" id="sign-out-btn" aria-label="Sign out">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
            </svg>
          </button>
        </div>
      `;
      document.getElementById('sign-out-btn')?.addEventListener('click', async (e) => {
        e.stopPropagation();
        await signOut();
        await storageRemove(['userEmail', 'cachedEmails', 'cachedEvents']);
        location.reload();
      });
    }
  }

  btn?.addEventListener('click', async () => {
    if (typeof chrome === 'undefined' || !chrome?.identity) return;
    try {
      const token = await new Promise((res, rej) =>
        chrome.identity.getAuthToken({ interactive: true }, t =>
          chrome.runtime.lastError
            ? rej(new Error(chrome.runtime.lastError.message))
            : res(t)
        )
      );
      const profile = await fetch(
        'https://www.googleapis.com/oauth2/v1/userinfo?alt=json',
        { headers: { Authorization: `Bearer ${token}` } }
      ).then(r => r.json());
      await storageSet({ userEmail: profile.email });
      location.reload();
    } catch (e) {
      console.error('[SergioSwift] Auth failed', e);
    }
  });

  checkAuth();
</script>

<style>
  .auth-panel { display: flex; align-items: center; }

  /* ── MD3 Outlined Button ─────────────────────────────────────────── */
  /* spec: h=40dp, shape=full, border=outline 1dp, px=24dp, labelLarge */
  .md3-btn--outlined {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 40px;
    padding: 0 24px;
    border-radius: var(--md-sys-shape-corner-full);
    border: 1px solid var(--md-sys-color-outline);
    background: transparent;
    color: var(--md-sys-color-primary);
    font: var(--md-sys-typescale-label-large);
    letter-spacing: var(--md-sys-typescale-label-large-tracking);
    cursor: pointer;
    transition: border-color 200ms;
    --state-color: var(--md-sys-color-primary);
  }
  .md3-btn--outlined:hover { border-color: var(--md-sys-color-primary); }

  /* ── MD3 Input Chip ───────────────────────────────────────────────── */
  /* spec: h=32dp, shape=full, border=outline-variant,                 */
  /*       leading=20dp avatar, labelLarge, trailing=18dp delete icon  */
  .input-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 32px;
    padding: 0 8px 0 4px;
    border-radius: var(--md-sys-shape-corner-full);
    border: 1px solid var(--md-sys-color-outline-variant);
    background: var(--md-sys-color-surface-container-low);
    color: var(--md-sys-color-on-surface);
    cursor: default;
    --state-color: var(--md-sys-color-on-surface);
  }

  .input-chip__avatar {
    flex-shrink: 0;
    width: 24px; height: 24px;
    border-radius: var(--md-sys-shape-corner-full);
    background: var(--md-sys-color-secondary-container);
    color: var(--md-sys-color-on-secondary-container);
    font: var(--md-sys-typescale-label-medium);
    letter-spacing: 0;
    display: flex; align-items: center; justify-content: center;
  }

  .input-chip__label {
    font: var(--md-sys-typescale-label-large);
    letter-spacing: var(--md-sys-typescale-label-large-tracking);
    max-width: 180px;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }

  /* Delete / sign-out icon button inside chip */
  .input-chip__delete {
    flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    width: 18px; height: 18px;
    padding: 0;
    border-radius: var(--md-sys-shape-corner-full);
    border: none; background: transparent;
    color: var(--md-sys-color-on-surface-variant);
    cursor: pointer;
    --state-color: var(--md-sys-color-on-surface-variant);
    transition: color 200ms;
  }
  .input-chip__delete:hover { color: var(--md-sys-color-on-surface); }
</style>
