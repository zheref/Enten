---
/**
 * StatusArea — Chrome OS-style system tray for the shelf's right side.
 *   Account (md-icon-button + md-menu) · Theme toggle (md-icon-button + md-menu) · Clock
 *
 * Theme toggle cycles light / auto / dark, persisted in chrome.storage.local
 * as { themeMode }, applied by toggling .dark-scheme on <html>.
 */
---

<div class="status-area">

  <!-- Auth — borderless person icon button + MD3 account menu -->
  <div class="auth-control">
    <md-icon-button id="auth-btn" title="Account"
                    aria-label="Account" aria-haspopup="menu" aria-expanded="false">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/>
      </svg>
    </md-icon-button>

    <md-menu id="auth-menu" anchor="auth-btn" positioning="fixed" y-offset="16"
             anchor-corner="start-start" menu-corner="end-start">
      <!-- Identity row (non-interactive) -->
      <md-menu-item class="account-row" disabled keep-open>
        <div slot="headline" id="auth-state">Not signed in</div>
        <div slot="supporting-text" id="auth-sub">Connect your Google account</div>
        <svg slot="start" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/>
        </svg>
      </md-menu-item>

      <md-menu-item id="auth-action" data-action="signin">
        <div slot="headline" id="auth-action-label">Sign in with Google</div>
        <svg slot="start" id="auth-action-icon" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M11 7 9.6 8.4l2.6 2.6H2v2h10.2l-2.6 2.6L11 17l5-5-5-5zm9 12h-8v2h8c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2h-8v2h8v14z"/>
        </svg>
      </md-menu-item>
    </md-menu>
  </div>

  <!-- Theme mode — borderless icon button (current theme glyph) + MD3 menu -->
  <div class="theme-toggle">
    <md-icon-button id="theme-btn" title="Change theme"
                    aria-label="Change theme" aria-haspopup="menu" aria-expanded="false">
      <!-- Current-theme glyph is injected by the script -->
    </md-icon-button>

    <md-menu id="theme-menu" anchor="theme-btn" positioning="fixed" y-offset="16"
             anchor-corner="start-start" menu-corner="end-start">
      <md-menu-item data-mode="light">
        <div slot="headline">Light</div>
        <svg slot="start" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 7c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zM2 13h2c.55 0 1-.45 1-1s-.45-1-1-1H2c-.55 0-1 .45-1 1s.45 1 1 1zm18 0h2c.55 0 1-.45 1-1s-.45-1-1-1h-2c-.55 0-1 .45-1 1s.45 1 1 1zM11 2v2c0 .55.45 1 1 1s1-.45 1-1V2c0-.55-.45-1-1-1s-1 .45-1 1zm0 18v2c0 .55.45 1 1 1s1-.45 1-1v-2c0-.55-.45-1-1-1s-1 .45-1 1zM5.99 4.58a.996.996 0 0 0-1.41 0 .996.996 0 0 0 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41L5.99 4.58zm12.37 12.37a.996.996 0 0 0-1.41 0 .996.996 0 0 0 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0a.996.996 0 0 0 0-1.41l-1.06-1.06zm1.06-12.37l-1.06 1.06a.996.996 0 0 0 0 1.41c.39.39 1.03.39 1.41 0l1.06-1.06a.996.996 0 0 0 0-1.41.996.996 0 0 0-1.41 0zM7.05 18.36l-1.06 1.06a.996.996 0 0 0 0 1.41c.39.39 1.03.39 1.41 0l1.06-1.06a.996.996 0 0 0 0-1.41.99.99 0 0 0-1.41 0z"/>
        </svg>
      </md-menu-item>
      <md-menu-item data-mode="auto">
        <div slot="headline">Automatic</div>
        <svg slot="start" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20 3H4c-1.1 0-2 .9-2 2v11c0 1.1.9 2 2 2h3l-1 1v2h12v-2l-1-1h3c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 13H4V5h16v11z"/>
        </svg>
      </md-menu-item>
      <md-menu-item data-mode="dark">
        <div slot="headline">Dark</div>
        <svg slot="start" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.389 5.389 0 0 1-4.4 2.26 5.403 5.403 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1z"/>
        </svg>
      </md-menu-item>
    </md-menu>
  </div>

  <!-- Clock — interactive button (hover state layer; no action yet) -->
  <button type="button" class="clock md3-state-layer" aria-label="Current time">
    <span class="clock__time" id="clock-time">--:--</span>
    <span class="clock__date" id="clock-date"></span>
  </button>

</div>

<script>
  import { storageGet, storageSet, storageRemove } from '../lib/storage.js';
  import { signOut } from '../lib/google.js';
  import { openCenteredMenu } from '../lib/menu.js';

  // ── Theme ─────────────────────────────────────────────────────────────────
  // SVG glyph (24×24 path) for each mode — shown on the toggle button.
  const GLYPHS: Record<string, string> = {
    light: '<path d="M12 7c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zM2 13h2c.55 0 1-.45 1-1s-.45-1-1-1H2c-.55 0-1 .45-1 1s.45 1 1 1zm18 0h2c.55 0 1-.45 1-1s-.45-1-1-1h-2c-.55 0-1 .45-1 1s.45 1 1 1zM11 2v2c0 .55.45 1 1 1s1-.45 1-1V2c0-.55-.45-1-1-1s-1 .45-1 1zm0 18v2c0 .55.45 1 1 1s1-.45 1-1v-2c0-.55-.45-1-1-1s-1 .45-1 1zM5.99 4.58a.996.996 0 0 0-1.41 0 .996.996 0 0 0 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41L5.99 4.58zm12.37 12.37a.996.996 0 0 0-1.41 0 .996.996 0 0 0 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0a.996.996 0 0 0 0-1.41l-1.06-1.06zm1.06-12.37l-1.06 1.06a.996.996 0 0 0 0 1.41c.39.39 1.03.39 1.41 0l1.06-1.06a.996.996 0 0 0 0-1.41.996.996 0 0 0-1.41 0zM7.05 18.36l-1.06 1.06a.996.996 0 0 0 0 1.41c.39.39 1.03.39 1.41 0l1.06-1.06a.996.996 0 0 0 0-1.41.99.99 0 0 0-1.41 0z"/>',
    auto:  '<path d="M20 3H4c-1.1 0-2 .9-2 2v11c0 1.1.9 2 2 2h3l-1 1v2h12v-2l-1-1h3c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 13H4V5h16v11z"/>',
    dark:  '<path d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.389 5.389 0 0 1-4.4 2.26 5.403 5.403 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1z"/>',
  };

  const themeBtn  = document.getElementById('theme-btn');
  const themeMenu = document.getElementById('theme-menu') as any;

  function setButtonGlyph(mode: string) {
    if (!themeBtn) return;
    themeBtn.innerHTML =
      `<svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">${GLYPHS[mode] ?? GLYPHS.auto}</svg>`;
  }

  function applyTheme(mode: string) {
    const root = document.documentElement;
    if (mode === 'dark') {
      root.classList.add('dark-scheme');
    } else if (mode === 'auto') {
      root.classList.toggle('dark-scheme',
        window.matchMedia('(prefers-color-scheme: dark)').matches);
    } else {
      root.classList.remove('dark-scheme');
    }
    setButtonGlyph(mode);
    // Canon MD3 selected state: fills the active item with secondary-container.
    document.querySelectorAll('#theme-menu md-menu-item').forEach(item => {
      (item as any).selected = (item as HTMLElement).dataset.mode === mode;
    });
  }

  async function initTheme() {
    const { themeMode } = await storageGet('themeMode') as any;
    applyTheme(themeMode ?? 'auto');
  }

  // Open the menu centred on the toggle button; keep the button's state ON.
  themeBtn?.addEventListener('click', () => {
    if (!themeMenu) return;
    if (themeMenu.open) { themeMenu.open = false; return; }
    openCenteredMenu(themeMenu, themeBtn);
    themeBtn.classList.add('menu-active');
    themeBtn.setAttribute('aria-expanded', 'true');
  });
  themeMenu?.addEventListener('closed', () => {
    themeBtn?.classList.remove('menu-active');
    themeBtn?.setAttribute('aria-expanded', 'false');
  });

  // Pick a mode from the menu items.
  document.querySelectorAll('#theme-menu md-menu-item').forEach(item => {
    item.addEventListener('click', async () => {
      const mode = (item as HTMLElement).dataset.mode ?? 'auto';
      await storageSet({ themeMode: mode });
      applyTheme(mode);                          // menu auto-closes on item click
    });
  });

  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', async () => {
    const { themeMode } = await storageGet('themeMode') as any;
    if ((themeMode ?? 'auto') === 'auto') applyTheme('auto');
  });

  initTheme();

  // ── Clock ─────────────────────────────────────────────────────────────────
  function updateClock() {
    const now = new Date();
    const t = document.getElementById('clock-time');
    const d = document.getElementById('clock-date');
    if (t) t.textContent = now.toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit' });
    if (d) d.textContent = now.toLocaleDateString(undefined, { weekday: 'short', month: 'short', day: 'numeric' });
  }
  updateClock();
  setInterval(updateClock, 10_000);

  // ── Auth ──────────────────────────────────────────────────────────────────
  const authBtn    = document.getElementById('auth-btn');
  const authMenu   = document.getElementById('auth-menu') as any;
  const authState  = document.getElementById('auth-state');
  const authSub    = document.getElementById('auth-sub');
  const authAction = document.getElementById('auth-action');
  const authActionLabel = document.getElementById('auth-action-label');
  const authActionIcon  = document.getElementById('auth-action-icon');

  const ICON_LOGIN  = '<path d="M11 7 9.6 8.4l2.6 2.6H2v2h10.2l-2.6 2.6L11 17l5-5-5-5zm9 12h-8v2h8c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2h-8v2h8v14z"/>';
  const ICON_LOGOUT = '<path d="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z"/>';

  // Reflect the current account state into the menu.
  async function checkAuth() {
    const { userEmail } = await storageGet('userEmail') as any;
    if (userEmail) {
      if (authState) authState.textContent = userEmail;
      if (authSub)   authSub.textContent = 'Signed in';
      if (authActionLabel) authActionLabel.textContent = 'Sign out';
      if (authActionIcon)  authActionIcon.innerHTML = ICON_LOGOUT;
      authAction?.setAttribute('data-action', 'signout');
      authBtn?.setAttribute('title', `Signed in as ${userEmail}`);
    } else {
      if (authState) authState.textContent = 'Not signed in';
      if (authSub)   authSub.textContent = 'Connect your Google account';
      if (authActionLabel) authActionLabel.textContent = 'Sign in with Google';
      if (authActionIcon)  authActionIcon.innerHTML = ICON_LOGIN;
      authAction?.setAttribute('data-action', 'signin');
      authBtn?.setAttribute('title', 'Account — not signed in');
    }
  }

  async function signIn() {
    if (typeof chrome === 'undefined' || !chrome?.identity) return;
    try {
      const token = await new Promise<string>((res, rej) =>
        chrome.identity.getAuthToken({ interactive: true }, (t: string) =>
          chrome.runtime.lastError ? rej(new Error(chrome.runtime.lastError.message)) : res(t)
        )
      );
      const profile = await fetch(
        'https://www.googleapis.com/oauth2/v1/userinfo?alt=json',
        { headers: { Authorization: `Bearer ${token}` } }
      ).then(r => r.json());
      await storageSet({ userEmail: profile.email });
      location.reload();
    } catch (e) { console.error('[SergioSwift] Auth error', e); }
  }

  // Open the account menu centred on the person button; keep its state ON.
  authBtn?.addEventListener('click', () => {
    if (!authMenu) return;
    if (authMenu.open) { authMenu.open = false; return; }
    openCenteredMenu(authMenu, authBtn);
    authBtn.classList.add('menu-active');
    authBtn.setAttribute('aria-expanded', 'true');
  });
  authMenu?.addEventListener('closed', () => {
    authBtn?.classList.remove('menu-active');
    authBtn?.setAttribute('aria-expanded', 'false');
  });

  // Sign in / sign out from the menu item.
  authAction?.addEventListener('click', async () => {
    if (authAction.getAttribute('data-action') === 'signout') {
      await signOut();
      await storageRemove(['userEmail', 'cachedEmails', 'cachedEvents']);
      location.reload();
    } else {
      await signIn();
    }
  });

  checkAuth();
</script>

<style>
  .status-area {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 100%;
  }

  /* Borderless theme toggle (icon button) + anchored menu.
     Active mode is shown via the canon md-menu-item[selected] state
     (secondary-container fill) — no custom check/colour needed. */
  .theme-toggle { position: relative; display: flex; align-items: center; }
  #theme-btn { --md-icon-button-icon-color: var(--shelf-glyph); }

  /* While a status button's menu is open, keep a persistent round state layer
     so it's clear which item the menu belongs to. */
  #theme-btn.menu-active, #auth-btn.menu-active {
    background: color-mix(in srgb, var(--md-sys-color-on-surface) 12%, transparent);
    border-radius: var(--md-sys-shape-corner-full);
  }

  /* Borderless account button + anchored account menu */
  .auth-control { position: relative; display: flex; align-items: center; }
  #auth-btn { --md-icon-button-icon-color: var(--shelf-glyph); }

  /* Identity row is a disabled md-menu-item; keep its text legible (the
     default disabled 38% opacity is too faint to read an email address). */
  #auth-menu .account-row {
    opacity: 1;
    --md-menu-item-label-text-color: var(--md-sys-color-on-surface);
    --md-menu-item-supporting-text-color: var(--md-sys-color-on-surface-variant);
    --md-menu-item-leading-icon-color: var(--md-sys-color-on-surface-variant);
  }
  /* Don't wrap the account email — let the menu grow horizontally to fit it
     (md-menu has no max-width cap, so a single line simply widens the menu). */
  #auth-state, #auth-sub { white-space: nowrap; }

  /* ── M3 Expressive "vertical menu" treatment ───────────────────────────────
     @material/web ships BASELINE M3 (4dp container, full-width square items).
     M3 Expressive vertical menus are rounder: a large-radius container holding
     inset, pill-shaped items, where hover/selected paints a fully-rounded
     state layer / secondary-container fill.

     We can reshape the items because md-menu-item's internal .list-item / md-item
     use `border-radius: inherit` — so a border-radius on the host cascades to the
     ripple, the selected fill, and the content. */
  #theme-menu, #auth-menu {
    --md-menu-container-shape: var(--md-sys-shape-corner-extra-large); /* 28dp */
    --md-menu-top-space: 8px;
    --md-menu-bottom-space: 8px;
  }
  #theme-menu md-menu-item,
  #auth-menu  md-menu-item {
    border-radius: var(--md-sys-shape-corner-large); /* 16dp — Expressive item shape */
    margin: 2px 8px;                                  /* inset from container edges */
  }
  /* Slightly more breathing room at the very top/bottom so pills clear the
     container's large rounded corners. */
  #theme-menu md-menu-item:first-of-type,
  #auth-menu  md-menu-item:first-of-type { margin-top: 4px; }
  #theme-menu md-menu-item:last-of-type,
  #auth-menu  md-menu-item:last-of-type  { margin-bottom: 4px; }

  /* ── Clock (interactive button with MD3 hover state layer) ───────── */
  .clock {
    display: flex; flex-direction: column; align-items: flex-end;
    justify-content: center;
    height: 40px; min-width: 72px;
    padding: 0 12px;
    border: none;
    background: transparent;
    border-radius: var(--md-sys-shape-corner-full);
    /* Default cursor — no action wired yet (see global cursor policy). */
    cursor: default;
    font-family: inherit;
    --state-color: var(--md-sys-color-on-surface);
  }
  /* Keep text above the state-layer ::before overlay (z-index 1) */
  .clock__time, .clock__date { position: relative; z-index: 2; }
  .clock__time {
    font: var(--md-sys-typescale-title-small);
    /* Halve the leading (token 20px → 17px) to tighten the two lines */
    line-height: 17px;
    letter-spacing: var(--md-sys-typescale-title-small-tracking);
    color: var(--md-sys-color-on-surface);
  }
  .clock__date {
    font: var(--md-sys-typescale-label-small);
    /* Halve the leading (token 16px → 13px) to tighten the two lines */
    line-height: 13px;
    letter-spacing: var(--md-sys-typescale-label-small-tracking);
    color: var(--shelf-glyph);
  }
</style>
