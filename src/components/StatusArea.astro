---
/**
 * StatusArea — Chrome OS-style system tray for the shelf's right side.
 *   Auth (md-text-button) · Theme toggle (md-outlined-segmented-button-set) · Clock
 *
 * Theme toggle cycles light / auto / dark, persisted in chrome.storage.local
 * as { themeMode }, applied by toggling .dark-scheme on <html>.
 */
---

<div class="status-area">

  <!-- Auth — official MD3 text button -->
  <md-text-button id="auth-btn" title="Connect Google account" has-icon>
    <svg slot="icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/>
    </svg>
    <span id="auth-label">Sign in</span>
  </md-text-button>

  <!-- Theme mode — official MD3 outlined segmented button set -->
  <md-outlined-segmented-button-set id="theme-set" aria-label="Color theme">
    <md-outlined-segmented-button data-mode="light" title="Light mode">
      <svg slot="icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 7c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zM2 13h2c.55 0 1-.45 1-1s-.45-1-1-1H2c-.55 0-1 .45-1 1s.45 1 1 1zm18 0h2c.55 0 1-.45 1-1s-.45-1-1-1h-2c-.55 0-1 .45-1 1s.45 1 1 1zM11 2v2c0 .55.45 1 1 1s1-.45 1-1V2c0-.55-.45-1-1-1s-1 .45-1 1zm0 18v2c0 .55.45 1 1 1s1-.45 1-1v-2c0-.55-.45-1-1-1s-1 .45-1 1zM5.99 4.58a.996.996 0 0 0-1.41 0 .996.996 0 0 0 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41L5.99 4.58zm12.37 12.37a.996.996 0 0 0-1.41 0 .996.996 0 0 0 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0a.996.996 0 0 0 0-1.41l-1.06-1.06zm1.06-12.37l-1.06 1.06a.996.996 0 0 0 0 1.41c.39.39 1.03.39 1.41 0l1.06-1.06a.996.996 0 0 0 0-1.41.996.996 0 0 0-1.41 0zM7.05 18.36l-1.06 1.06a.996.996 0 0 0 0 1.41c.39.39 1.03.39 1.41 0l1.06-1.06a.996.996 0 0 0 0-1.41.99.99 0 0 0-1.41 0z"/>
      </svg>
    </md-outlined-segmented-button>
    <md-outlined-segmented-button data-mode="auto" selected title="Auto (system)">
      <svg slot="icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
        <path d="M20 3H4c-1.1 0-2 .9-2 2v11c0 1.1.9 2 2 2h3l-1 1v2h12v-2l-1-1h3c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 13H4V5h16v11z"/>
      </svg>
    </md-outlined-segmented-button>
    <md-outlined-segmented-button data-mode="dark" title="Dark mode">
      <svg slot="icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.389 5.389 0 0 1-4.4 2.26 5.403 5.403 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1z"/>
      </svg>
    </md-outlined-segmented-button>
  </md-outlined-segmented-button-set>

  <!-- Clock -->
  <div class="clock" aria-live="polite" aria-label="Current time">
    <span class="clock__time" id="clock-time">--:--</span>
    <span class="clock__date" id="clock-date"></span>
  </div>

</div>

<script>
  import { storageGet, storageSet, storageRemove } from '../lib/storage.js';
  import { signOut } from '../lib/google.js';

  // ── Theme ─────────────────────────────────────────────────────────────────
  function applyTheme(mode: string) {
    const root = document.documentElement;
    if (mode === 'dark') {
      root.classList.add('dark-scheme');
    } else if (mode === 'auto') {
      root.classList.toggle('dark-scheme',
        window.matchMedia('(prefers-color-scheme: dark)').matches);
    } else {
      root.classList.remove('dark-scheme');
    }
    // Reflect selection on the official segmented buttons
    document.querySelectorAll('md-outlined-segmented-button').forEach(btn => {
      (btn as any).selected = (btn as HTMLElement).dataset.mode === mode;
    });
  }

  async function initTheme() {
    const { themeMode } = await storageGet('themeMode') as any;
    applyTheme(themeMode ?? 'auto');
  }

  document.querySelectorAll('md-outlined-segmented-button').forEach(btn => {
    btn.addEventListener('click', async () => {
      const mode = (btn as HTMLElement).dataset.mode ?? 'auto';
      await storageSet({ themeMode: mode });
      applyTheme(mode);
    });
  });

  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', async () => {
    const { themeMode } = await storageGet('themeMode') as any;
    if ((themeMode ?? 'auto') === 'auto') applyTheme('auto');
  });

  initTheme();

  // ── Clock ─────────────────────────────────────────────────────────────────
  function updateClock() {
    const now = new Date();
    const t = document.getElementById('clock-time');
    const d = document.getElementById('clock-date');
    if (t) t.textContent = now.toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit' });
    if (d) d.textContent = now.toLocaleDateString(undefined, { weekday: 'short', month: 'short', day: 'numeric' });
  }
  updateClock();
  setInterval(updateClock, 10_000);

  // ── Auth ──────────────────────────────────────────────────────────────────
  const authBtn   = document.getElementById('auth-btn');
  const authLabel = document.getElementById('auth-label');

  async function checkAuth() {
    const { userEmail } = await storageGet('userEmail') as any;
    if (userEmail && authLabel) {
      authLabel.textContent = userEmail.split('@')[0];
      authBtn?.setAttribute('title', `Signed in as ${userEmail} — click to sign out`);
    }
  }

  authBtn?.addEventListener('click', async () => {
    const { userEmail } = await storageGet('userEmail') as any;
    if (userEmail) {
      await signOut();
      await storageRemove(['userEmail', 'cachedEmails', 'cachedEvents']);
      location.reload();
    } else {
      if (typeof chrome === 'undefined' || !chrome?.identity) return;
      try {
        const token = await new Promise<string>((res, rej) =>
          chrome.identity.getAuthToken({ interactive: true }, (t: string) =>
            chrome.runtime.lastError ? rej(new Error(chrome.runtime.lastError.message)) : res(t)
          )
        );
        const profile = await fetch(
          'https://www.googleapis.com/oauth2/v1/userinfo?alt=json',
          { headers: { Authorization: `Bearer ${token}` } }
        ).then(r => r.json());
        await storageSet({ userEmail: profile.email });
        location.reload();
      } catch (e) { console.error('[SergioSwift] Auth error', e); }
    }
  });

  checkAuth();
</script>

<style>
  .status-area {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 100%;
  }

  /* Compact the segmented set to fit the 56dp shelf */
  #theme-set {
    --md-outlined-segmented-button-container-height: 36px;
  }
  #auth-btn { --md-text-button-label-text-color: var(--md-sys-color-on-surface-variant); }
  #auth-label { max-width: 120px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  /* ── Clock ──────────────────────────────────────────────────────── */
  .clock {
    display: flex; flex-direction: column; align-items: flex-end;
    padding: 0 8px 0 4px;
    min-width: 72px;
  }
  .clock__time {
    font: var(--md-sys-typescale-title-small);
    letter-spacing: var(--md-sys-typescale-title-small-tracking);
    color: var(--md-sys-color-on-surface);
  }
  .clock__date {
    font: var(--md-sys-typescale-label-small);
    letter-spacing: var(--md-sys-typescale-label-small-tracking);
    color: var(--md-sys-color-on-surface-variant);
  }
</style>
