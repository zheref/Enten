---
/**
 * CustomizePanel — centred, closeable & collapsible card to customise the
 * dashboard. Opened via the `open-customize` window event (from the desktop
 * menu). Content is a placeholder for now. Reuses the .widget-card chrome.
 */
---

<md-elevated-card class="widget-card expanded customize-card is-hidden" id="customize-card">
  <div class="widget-card__clip">

    <div class="widget-card__header">
      <span class="widget-card__icon" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M3 17v2h6v-2H3zM3 5v2h10V5H3zm10 16v-2h8v-2h-8v-2h-2v6h2zM7 9v2H3v2h4v2h2V9H7zm14 4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z"/>
        </svg>
      </span>
      <span class="widget-card__title">Customize</span>
      <md-icon-button class="widget-toggle" id="cz-toggle" aria-label="Collapse">
        <svg class="chevron" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 8l-6 6 1.41 1.41L12 10.83l4.59 4.58L18 14z"/>
        </svg>
      </md-icon-button>
      <md-icon-button id="cz-close" aria-label="Close">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
        </svg>
      </md-icon-button>
    </div>

    <div class="widget-card__body">
      <div class="widget-card__body-inner">
        <div class="cz-content">
          <div class="cz-section-label">Wallpaper</div>
          <div class="cz-wallpapers" id="cz-wallpapers" role="list">
            <!-- Populated by script -->
          </div>
        </div>
      </div>
    </div>

  </div>
</md-elevated-card>

<script>
  import { storageGet, storageSet } from '../lib/storage.js';
  import { WALLPAPERS, DEFAULT_WALLPAPER, wallpaperSrc } from '../lib/wallpapers.js';

  const card = document.getElementById('customize-card') as HTMLElement;
  const grid = document.getElementById('cz-wallpapers') as HTMLElement;
  const liveWallpaper = () => document.querySelector('.wallpaper img') as HTMLImageElement | null;

  async function renderWallpapers() {
    const { wallpaper = DEFAULT_WALLPAPER } = await storageGet('wallpaper') as any;
    grid.innerHTML = WALLPAPERS.map(w => `
      <button class="cz-wp ${w.id === wallpaper ? 'is-selected' : ''}" data-id="${w.id}"
              role="listitem" title="${w.label}" aria-label="${w.label}">
        <img src="${w.src}" alt="" loading="lazy" />
        <span class="cz-wp__check" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
        </span>
        <span class="cz-wp__label">${w.label}</span>
      </button>
    `).join('');
  }

  grid?.addEventListener('click', async (e: MouseEvent) => {
    const btn = (e.target as HTMLElement).closest('.cz-wp') as HTMLElement | null;
    if (!btn) return;
    const id = btn.dataset.id!;
    await storageSet({ wallpaper: id });
    const img = liveWallpaper();
    if (img) img.src = wallpaperSrc(id);
    grid.querySelectorAll('.cz-wp').forEach(b =>
      b.classList.toggle('is-selected', (b as HTMLElement).dataset.id === id));
  });

  renderWallpapers();

  window.addEventListener('open-customize', () => {
    renderWallpapers();
    card.classList.remove('is-hidden');
    card.classList.add('expanded');
  });

  document.getElementById('cz-close')?.addEventListener('click', () => {
    card.classList.add('is-hidden');
  });

  const toggle = document.getElementById('cz-toggle');
  toggle?.addEventListener('click', () => {
    const expanded = card.classList.toggle('expanded');
    toggle.setAttribute('aria-label', expanded ? 'Collapse' : 'Expand');
  });

  requestAnimationFrame(() => card.classList.add('anim-ready'));
</script>

<style is:global>
  .customize-card {
    position: fixed;
    left: 50%; top: 50%;
    transform: translate(-50%, -50%);    /* centred on screen */
    width: 360px;
    max-width: calc(100vw - 32px);
    z-index: 45;                          /* above shelf + widgets */
  }
  .customize-card.is-hidden { display: none !important; }

  .cz-content { padding: 16px; display: flex; flex-direction: column; gap: 10px; }
  .cz-section-label {
    font: var(--md-sys-typescale-title-small);
    letter-spacing: var(--md-sys-typescale-title-small-tracking);
    color: var(--md-sys-color-on-surface);
  }

  .cz-wallpapers {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .cz-wp {
    position: relative;
    padding: 0;
    border: 2px solid transparent;
    border-radius: var(--md-sys-shape-corner-medium);
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: var(--md-sys-color-surface-container-high);
    transition: border-color 150ms ease, box-shadow 150ms ease;
  }
  .cz-wp img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .cz-wp:hover { box-shadow: var(--md-sys-elevation-level2); }
  .cz-wp.is-selected { border-color: var(--md-sys-color-primary); }

  /* Selected check badge */
  .cz-wp__check {
    position: absolute; top: 6px; right: 6px;
    display: none;
    align-items: center; justify-content: center;
    width: 24px; height: 24px;
    border-radius: var(--md-sys-shape-corner-full);
    background: var(--md-sys-color-primary);
    color: var(--md-sys-color-on-primary);
  }
  .cz-wp.is-selected .cz-wp__check { display: flex; }

  /* Label chip at the bottom */
  .cz-wp__label {
    position: absolute; left: 0; right: 0; bottom: 0;
    padding: 4px 8px;
    font: var(--md-sys-typescale-label-medium);
    letter-spacing: var(--md-sys-typescale-label-medium-tracking);
    color: #fff;
    text-align: left;
    background: linear-gradient(to top, rgba(0,0,0,0.55), rgba(0,0,0,0));
  }
</style>
