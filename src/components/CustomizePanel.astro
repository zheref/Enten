---
/**
 * CustomizePanel — centred, closeable & collapsible card to customise the
 * dashboard. Opened via the `open-customize` window event (from the desktop
 * menu). Content is a placeholder for now. Reuses the .widget-card chrome.
 */
---

<md-elevated-card class="widget-card expanded customize-card is-hidden" id="customize-card">
  <div class="widget-card__clip">

    <div class="widget-card__header">
      <span class="widget-card__icon" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M3 17v2h6v-2H3zM3 5v2h10V5H3zm10 16v-2h8v-2h-8v-2h-2v6h2zM7 9v2H3v2h4v2h2V9H7zm14 4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z"/>
        </svg>
      </span>
      <span class="widget-card__title">Customize</span>
      <md-icon-button class="widget-toggle" id="cz-toggle" aria-label="Collapse">
        <svg class="chevron" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 8l-6 6 1.41 1.41L12 10.83l4.59 4.58L18 14z"/>
        </svg>
      </md-icon-button>
      <md-icon-button id="cz-close" aria-label="Close">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
        </svg>
      </md-icon-button>
    </div>

    <div class="widget-card__body">
      <div class="widget-card__body-inner">
        <div class="cz-content">
          <div class="cz-section-label">Theme</div>
          <div class="cz-themes" id="cz-themes" role="list">
            <!-- Populated by script -->
          </div>
          <md-filled-button id="cz-download" has-icon>
            <svg slot="icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/>
            </svg>
            Download Chrome theme (.zip)
          </md-filled-button>
        </div>
      </div>
    </div>

  </div>
</md-elevated-card>

<script>
  import JSZip from 'jszip';
  import { storageGet, storageSet } from '../lib/storage.js';
  import { THEMES, DEFAULT_THEME, getTheme, applyThemeToDashboard, buildThemeManifest } from '../lib/themes.js';
  import { showSnackbar } from '../lib/snackbar.js';

  const card = document.getElementById('customize-card') as HTMLElement;
  const grid = document.getElementById('cz-themes') as HTMLElement;
  let selectedId = DEFAULT_THEME;

  async function render() {
    const { theme = DEFAULT_THEME } = await storageGet('theme') as any;
    selectedId = theme;
    grid.innerHTML = THEMES.map(t => `
      <button class="cz-theme ${t.id === theme ? 'is-selected' : ''}" data-id="${t.id}"
              role="listitem" title="${t.label}" aria-label="${t.label}">
        <span class="cz-theme__preview"><img src="${t.src}" alt="" loading="lazy" /></span>
        <span class="cz-theme__palette" aria-hidden="true">
          <span class="cz-sw" style="background:${t.accent}"></span>
          <span class="cz-sw" style="background:${t.background}"></span>
        </span>
        <span class="cz-theme__label">${t.label}</span>
        <span class="cz-theme__check" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
        </span>
      </button>
    `).join('');
  }

  // Pick a theme → recolour + swap wallpaper, persist, update selection.
  grid?.addEventListener('click', async (e: MouseEvent) => {
    const btn = (e.target as HTMLElement).closest('.cz-theme') as HTMLElement | null;
    if (!btn) return;
    selectedId = btn.dataset.id!;
    await storageSet({ theme: selectedId });
    applyThemeToDashboard(selectedId);
    grid.querySelectorAll('.cz-theme').forEach(b =>
      b.classList.toggle('is-selected', (b as HTMLElement).dataset.id === selectedId));
  });

  // Generate an installable Chrome theme (.zip) for the selected theme.
  document.getElementById('cz-download')?.addEventListener('click', async () => {
    const theme = getTheme(selectedId);
    try {
      const zip = new JSZip();
      zip.file('manifest.json', JSON.stringify(buildThemeManifest(theme), null, 2));
      const imgBlob = await fetch(theme.src).then(r => r.blob());
      zip.folder('images')!.file('wallpaper.jpg', imgBlob);
      const blob = await zip.generateAsync({ type: 'blob' });

      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `sergioswift-${theme.id}-theme.zip`;
      document.body.appendChild(a); a.click(); a.remove();
      URL.revokeObjectURL(url);
      showSnackbar(`${theme.label} theme downloaded`);
    } catch (err) {
      console.error('[SergioSwift] Theme zip failed', err);
      showSnackbar('Couldn’t generate the theme');
    }
  });

  render();

  window.addEventListener('open-customize', () => {
    render();
    card.classList.remove('is-hidden');
    card.classList.add('expanded');
  });

  document.getElementById('cz-close')?.addEventListener('click', () => {
    card.classList.add('is-hidden');
  });

  const toggle = document.getElementById('cz-toggle');
  toggle?.addEventListener('click', () => {
    const expanded = card.classList.toggle('expanded');
    toggle.setAttribute('aria-label', expanded ? 'Collapse' : 'Expand');
  });

  requestAnimationFrame(() => card.classList.add('anim-ready'));
</script>

<style is:global>
  .customize-card {
    position: fixed;
    left: 50%; top: 50%;
    transform: translate(-50%, -50%);    /* centred on screen */
    width: 360px;
    max-width: calc(100vw - 32px);
    z-index: 45;                          /* above shelf + widgets */
  }
  .customize-card.is-hidden { display: none !important; }

  .cz-content { padding: 16px; display: flex; flex-direction: column; gap: 12px; }
  .cz-section-label {
    font: var(--md-sys-typescale-title-small);
    letter-spacing: var(--md-sys-typescale-title-small-tracking);
    color: var(--md-sys-color-on-surface);
  }

  .cz-themes { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }

  .cz-theme {
    position: relative;
    display: flex; flex-direction: column;
    padding: 0;
    border: 2px solid transparent;
    border-radius: var(--md-sys-shape-corner-medium);
    overflow: hidden;
    background: var(--md-sys-color-surface-container-high);
    text-align: left;
    transition: border-color 150ms ease, box-shadow 150ms ease;
  }
  .cz-theme:hover { box-shadow: var(--md-sys-elevation-level2); }
  .cz-theme.is-selected { border-color: var(--md-sys-color-primary); }

  .cz-theme__preview { display: block; aspect-ratio: 16 / 9; }
  .cz-theme__preview img { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* Two-colour palette strip */
  .cz-theme__palette { display: flex; height: 14px; }
  .cz-sw { flex: 1; }

  .cz-theme__label {
    padding: 6px 10px;
    font: var(--md-sys-typescale-label-large);
    letter-spacing: var(--md-sys-typescale-label-large-tracking);
    color: var(--md-sys-color-on-surface);
  }

  .cz-theme__check {
    position: absolute; top: 6px; right: 6px;
    display: none;
    align-items: center; justify-content: center;
    width: 22px; height: 22px;
    border-radius: var(--md-sys-shape-corner-full);
    background: var(--md-sys-color-primary);
    color: var(--md-sys-color-on-primary);
  }
  .cz-theme.is-selected .cz-theme__check { display: flex; }

  #cz-download { width: 100%; }
</style>
