---
import CalendarWidget from '../components/CalendarWidget.astro';
import EmailWidget    from '../components/EmailWidget.astro';
import Shortcuts      from '../components/Shortcuts.astro';
import StatusArea     from '../components/StatusArea.astro';
import ContainmentAdjuster from '../components/ContainmentAdjuster.astro';
import CustomizePanel       from '../components/CustomizePanel.astro';
import '../styles/theme.css';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <title>New Tab</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet" />
</head>
<body>

  <!-- ── Full-bleed wallpaper ──────────────────────────────────────── -->
  <div class="wallpaper" aria-hidden="true">
    <img src="/images/naruto-swift.jpg" alt="" />
    <div class="wallpaper__scrim"></div>
  </div>

  <!-- ── Desktop (full viewport — shelf floats on top) ─────────────── -->
  <main class="desktop" id="desktop">

    <!-- Flex container used when widgets are anchored to an edge. Widgets are
         moved in/out of here; flex handles alignment + re-packing on collapse. -->
    <div id="anchor-zone"></div>

    <div class="widget-wrapper" id="widget-calendar" data-widget="calendar">
      <CalendarWidget />
    </div>

    <div class="widget-wrapper" id="widget-email" data-widget="email">
      <EmailWidget />
    </div>

  </main>

  <!-- ── Floating Shelf ───────────────────────────────────────────── -->
  <!--
    Floating pill: not touching window edges, rounded corners.
    Left:  launcher FAB · divider · pinned app icons
    Right: status area (auth · theme toggle · clock)
  -->
  <nav class="shelf" aria-label="Shelf">
    <!-- Left zone: launcher glyph (decorative — flat, non-interactive) -->
    <div class="shelf__zone shelf__zone--start">
      <span class="launcher" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
          <path d="M4 8h4V4H4v4zm6 12h4v-4h-4v4zm-6 0h4v-4H4v4zm0-6h4v-4H4v4zm6 0h4v-4h-4v4zm6-10v4h4V4h-4zm-6 4h4V4h-4v4zm6 6h4v-4h-4v4zm0 6h4v-4h-4v4z"/>
        </svg>
      </span>
    </div>

    <!-- Center zone: app shortcuts (horizontally centred in the bar) -->
    <div class="shelf__zone shelf__zone--center">
      <Shortcuts />
    </div>

    <!-- Right zone: status area -->
    <div class="shelf__zone shelf__zone--end">
      <StatusArea />
    </div>
  </nav>

  <!-- Floating panel to tune a bookmark icon's containment (opened on demand) -->
  <ContainmentAdjuster />

  <!-- Centred panel to customise the dashboard (opened on demand) -->
  <CustomizePanel />

  <!-- Desktop (wallpaper) menu — anchored at the cursor via a 0-size element -->
  <div id="desktop-anchor" aria-hidden="true" style="position:fixed;width:0;height:0;"></div>
  <md-menu id="desktop-menu" positioning="fixed" anchor-corner="start-start" menu-corner="start-start">
    <md-sub-menu>
      <md-menu-item slot="item">
        <svg slot="start" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17 15l1.55 1.55c-.96 1.69-3.33 3.04-5.55 3.37V11h3V9h-3V7.82C14.16 7.4 15 6.3 15 5c0-1.65-1.35-3-3-3S9 3.35 9 5c0 1.3.84 2.4 2 2.82V9H8v2h3v9.92c-2.22-.33-4.59-1.68-5.55-3.37L7 15l-4-3v3c0 3.88 4.92 7 9 7s9-3.12 9-7v-3l-4 3z"/>
        </svg>
        <div slot="headline">Anchor Widgets</div>
        <svg slot="end" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M10 17l5-5-5-5v10z"/>
        </svg>
      </md-menu-item>
      <md-menu slot="menu" positioning="fixed">
        <md-menu-item data-side="top"><div slot="headline">Top</div>
          <svg slot="start" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M7.41 15.41L12 10.83l4.59 4.58L18 14l-6-6-6 6z"/></svg>
        </md-menu-item>
        <md-menu-item data-side="right"><div slot="headline">Right</div>
          <svg slot="start" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6z"/></svg>
        </md-menu-item>
        <md-menu-item data-side="bottom"><div slot="headline">Bottom</div>
          <svg slot="start" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6z"/></svg>
        </md-menu-item>
        <md-menu-item data-side="left"><div slot="headline">Left</div>
          <svg slot="start" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M15.41 16.59L10.83 12l4.58-4.59L14 6l-6 6 6 6z"/></svg>
        </md-menu-item>
      </md-menu>
    </md-sub-menu>
    <md-menu-item id="desktop-customize">
      <svg slot="start" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M3 17v2h6v-2H3zM3 5v2h10V5H3zm10 16v-2h8v-2h-8v-2h-2v6h2zM7 9v2H3v2h4v2h2V9H7zm14 4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z"/>
      </svg>
      <div slot="headline">Customize</div>
    </md-menu-item>
  </md-menu>

</body>
</html>

<!-- ── Widget drag & restore ──────────────────────────────────────── -->
<script>
  // Register all Material Web Components (defines <md-*> custom elements).
  import '../lib/md-components.ts';
  import { storageGet, storageSet } from '../lib/storage.js';
  import { installCursorFix } from '../lib/cursor-fix.js';
  import { applyThemeToDashboard, DEFAULT_THEME } from '../lib/themes.js';

  // Apply the saved theme (wallpaper + colours) as early as possible.
  async function applySavedTheme() {
    const { theme = DEFAULT_THEME } = await storageGet('theme') as any;
    applyThemeToDashboard(theme);
  }
  applySavedTheme();

  const SHELF_CLEARANCE = 56 + 8 + 8; // floating shelf: height + float gap + clearance gap
  const CARD_W = 380;
  const CARD_H = 480;

  function clamp(val: number, min: number, max: number) {
    return Math.max(min, Math.min(max, val));
  }

  function initDrag(el: HTMLElement, key: string) {
    const header = el.querySelector<HTMLElement>('[data-drag-handle]');
    if (!header) return;
    // Title bar uses the default cursor (no grab/grabbing).

    let dragging = false, startPX = 0, startPY = 0, startLeft = 0, startTop = 0;

    header.addEventListener('pointerdown', (e: PointerEvent) => {
      // Don't start a drag when pressing an interactive control in the header
      // (toggle / refresh buttons) — let their click through.
      if ((e.target as HTMLElement).closest('md-icon-button, button, a')) return;
      // Dragging an anchored card releases it back to free positioning.
      clearAnchor();
      dragging = true;
      startPX = e.clientX;
      startPY = e.clientY;
      startLeft = el.offsetLeft;
      startTop  = el.offsetTop;
      el.setPointerCapture(e.pointerId);
      el.style.transition = 'none';
      el.style.zIndex = '50';
      e.preventDefault();
    });

    el.addEventListener('pointermove', (e: PointerEvent) => {
      if (!dragging) return;
      const desktop = document.getElementById('desktop')!;
      const maxL = desktop.offsetWidth  - el.offsetWidth;
      // Allow the full desktop height — cards may slide under the shelf, which
      // sits above them in z-order (it's z-index 20, the cards are z-index 10).
      const maxT = desktop.offsetHeight - el.offsetHeight;

      el.style.left = clamp(startLeft + e.clientX - startPX, 0, maxL) + 'px';
      el.style.top  = clamp(startTop  + e.clientY - startPY, 0, Math.max(0, maxT)) + 'px';
    });

    const onUp = async () => {
      if (!dragging) return;
      dragging = false;
      el.style.transition = '';
      el.style.zIndex = '';
      const { widgetPositions = {} } = await storageGet('widgetPositions') as any;
      widgetPositions[key] = { left: el.offsetLeft, top: el.offsetTop };
      await storageSet({ widgetPositions });
    };
    el.addEventListener('pointerup',    onUp);
    el.addEventListener('pointercancel', onUp);
  }

  async function init() {
    const desktop  = document.getElementById('desktop')!;
    const calEl    = document.getElementById('widget-calendar') as HTMLElement;
    const emailEl  = document.getElementById('widget-email')    as HTMLElement;
    if (!calEl || !emailEl) return;

    initDrag(calEl,   'calendar');
    initDrag(emailEl, 'email');

    // Anchored layout takes precedence over free positions.
    const { widgetAnchor } = await storageGet('widgetAnchor') as any;
    if (widgetAnchor) { applyAnchor(widgetAnchor); return; }

    const { widgetPositions = {} } = await storageGet('widgetPositions') as any;
    const dw = desktop.offsetWidth;
    const dh = desktop.offsetHeight;
    const defaultTop = Math.max(16, dh - CARD_H - SHELF_CLEARANCE);

    const cal  = (widgetPositions as any).calendar ?? { left: 24,               top: defaultTop };
    const eml  = (widgetPositions as any).email    ?? { left: dw - CARD_W - 24, top: defaultTop };

    calEl.style.left  = `${clamp(cal.left, 0, dw - CARD_W)}px`;
    calEl.style.top   = `${clamp(cal.top,  0, dh - CARD_H)}px`;
    emailEl.style.left = `${clamp(eml.left, 0, dw - CARD_W)}px`;
    emailEl.style.top  = `${clamp(eml.top,  0, dh - CARD_H)}px`;
  }

  // ── Anchor the widget cards to an edge (flex layout) ────────────────────────
  // Flexbox does the heavy lifting: it keeps the cards aligned to the edge and
  // re-packs/animates them automatically as a card collapses/expands (its height
  // animates, flex re-lays out each frame). 'bottom' uses align-items:flex-end so
  // a collapsing card keeps its title bar at the bottom; 'top' uses flex-start.
  let currentAnchor: string | null = null;

  function applyAnchor(side: string) {
    const zone = document.getElementById('anchor-zone')!;
    const cal  = document.getElementById('widget-calendar') as HTMLElement;
    const eml  = document.getElementById('widget-email')    as HTMLElement;
    zone.appendChild(cal);
    zone.appendChild(eml);
    [cal, eml].forEach(el => { el.style.left = ''; el.style.top = ''; el.style.zIndex = ''; });
    zone.setAttribute('data-side', side);
    currentAnchor = side;
  }

  // Move the cards back to free (absolute) positioning, keeping their current
  // on-screen position. Called when the user starts dragging an anchored card.
  function clearAnchor() {
    const zone    = document.getElementById('anchor-zone')!;
    if (!zone.hasAttribute('data-side')) return;
    const desktop = document.getElementById('desktop')!;
    const cal = document.getElementById('widget-calendar') as HTMLElement;
    const eml = document.getElementById('widget-email')    as HTMLElement;
    const dr = desktop.getBoundingClientRect();
    [cal, eml].forEach(el => {
      const r = el.getBoundingClientRect();
      desktop.appendChild(el);
      el.style.left = (r.left - dr.left) + 'px';
      el.style.top  = (r.top  - dr.top)  + 'px';
    });
    zone.removeAttribute('data-side');
    currentAnchor = null;
    storageSet({
      widgetAnchor: null,
      widgetPositions: {
        calendar: { left: cal.offsetLeft, top: cal.offsetTop },
        email:    { left: eml.offsetLeft, top: eml.offsetTop },
      },
    });
  }

  async function anchorWidgets(side: string) {
    applyAnchor(side);
    await storageSet({ widgetAnchor: side });
  }

  // ── Desktop (wallpaper) menu ────────────────────────────────────────────────
  function setupDesktopMenu() {
    const wallpaper = document.querySelector('.wallpaper') as HTMLElement | null;
    const anchor    = document.getElementById('desktop-anchor') as HTMLElement;
    const menu      = document.getElementById('desktop-menu') as any;
    if (!wallpaper || !anchor || !menu) return;

    function openAt(x: number, y: number) {
      // Close first so a repeated secondary-click re-opens at the new spot
      // (md-menu's outside-close only listens for left clicks, not contextmenu).
      menu.open = false;
      anchor.style.left = x + 'px';
      anchor.style.top  = y + 'px';
      menu.anchorElement = anchor;
      requestAnimationFrame(() => { menu.open = true; });
    }
    // Secondary (right) click on blank wallpaper space reveals the menu.
    wallpaper.addEventListener('contextmenu', (e: MouseEvent) => {
      e.preventDefault();
      openAt(e.clientX, e.clientY);
    });

    menu.querySelectorAll('md-menu-item[data-side]').forEach((item: HTMLElement) => {
      item.addEventListener('click', () => anchorWidgets(item.dataset.side || 'top'));
    });
    document.getElementById('desktop-customize')?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('open-customize'));
    });
  }

  init();
  setupDesktopMenu();
  installCursorFix();
</script>

<style>
  /* ── Wallpaper ─────────────────────────────────────────────────────── */
  .wallpaper {
    position: fixed; inset: 0; z-index: 0;
    background: var(--md-sys-color-background);
  }
  .wallpaper img {
    width: 100%; height: 100%;
    object-fit: cover; object-position: center; display: block;
  }
  .wallpaper__scrim {
    position: absolute; inset: 0;
    background: var(--wallpaper-scrim);
  }

  /* ── Desktop ─────────────────────────────────────────────────────── */
  .desktop {
    position: fixed; inset: 0;
    z-index: 10;
    /* pointer-events off on the container so clicks pass through to wallpaper */
    pointer-events: none;
  }

  /* ── Widget wrappers (absolutely positioned, draggable) ──────────── */
  .widget-wrapper {
    position: absolute;
    width: 380px;
    /* Height follows the card so a collapsed card leaves no invisible,
       click-blocking area below it. */
    height: auto;
    pointer-events: auto;
    /* initial offscreen — JS sets real position immediately */
    left: -9999px; top: -9999px;
  }

  /* ── Anchor zone — flex layout for edge-anchored widgets ─────────────
     Spans the desktop above the shelf. Flexbox keeps the cards aligned and
     re-packs/animates them as a card collapses (its height animates). */
  #anchor-zone {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: var(--shelf-clearance);   /* clear the floating shelf */
    display: none;
    pointer-events: none;                       /* empty areas pass clicks through */
    z-index: 10;
  }
  #anchor-zone[data-side] { display: flex; }
  #anchor-zone > .widget-wrapper {
    position: relative;
    left: auto; top: auto;
    pointer-events: auto;
  }
  /* Vertical edges (top/bottom): side-by-side row, centred horizontally.
     Bottom aligns to flex-end so a collapsing card keeps its title bar down. */
  #anchor-zone[data-side="top"]    { flex-flow: row;    justify-content: center; align-items: flex-start; gap: 24px; padding: 16px 24px; }
  #anchor-zone[data-side="bottom"] { flex-flow: row;    justify-content: center; align-items: flex-end;   gap: 24px; padding: 16px 24px; }
  /* Left/right edges: stacked column, top-aligned (NOT vertically centred),
     with a greater horizontal gap from the edge; re-packs as cards collapse. */
  #anchor-zone[data-side="left"]   { flex-flow: column; justify-content: flex-start; align-items: flex-start; gap: 16px; padding: 24px 56px; }
  #anchor-zone[data-side="right"]  { flex-flow: column; justify-content: flex-start; align-items: flex-end;   gap: 16px; padding: 24px 56px; }

  /* ── Floating shelf ─────────────────────────────────────────────────
   * A piece of floating glass: lifted off the bottom edge by --shelf-gap,
   * inset by --shelf-margin horizontally, fully rounded on every corner,
   * with a full outline + elevation shadow (both theme-agnostic).
   */
  .shelf {
    position: fixed;
    bottom: var(--shelf-gap);
    left: var(--shelf-margin);
    right: var(--shelf-margin);
    z-index: 20;
    height: var(--shelf-height);
    /* 3-column grid: equal 1fr sides keep the auto centre zone (the app
       shortcuts) horizontally centred in the bar regardless of side widths. */
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 0 12px;
    border-radius: var(--md-sys-shape-corner-extra-large);   /* all corners */
    background: var(--shelf-bg);
    /* Opacity + blur radius are tunable in src/styles/theme.css
       (--shelf-opacity / --shelf-blur), per light & dark scheme. */
    backdrop-filter: blur(var(--shelf-blur)) saturate(1.8);
    -webkit-backdrop-filter: blur(var(--shelf-blur)) saturate(1.8);
    /* Full outline + level-1 shadow define the floating piece (both adapt to
       the colour scheme / stay constant across themes). */
    border: 1px solid var(--md-sys-color-outline-variant);
    box-shadow: var(--md-sys-elevation-level1);
  }

  .shelf__zone {
    display: flex; align-items: center; height: 100%;
  }
  .shelf__zone--start  { justify-content: flex-start; }
  .shelf__zone--center { justify-content: center; }
  .shelf__zone--end    { justify-content: flex-end; }

  /* ── Launcher glyph — flat, non-interactive decoration ───────────── */
  .launcher {
    display: flex; align-items: center; justify-content: center;
    width: 40px; height: 40px;
    flex-shrink: 0;
    /* "All apps" launcher is decorative — lighter/muted than the other glyphs */
    color: var(--md-sys-color-on-surface-variant);
    pointer-events: none;       /* no clicks */
    /* no background, no elevation, no hover/ripple */
  }
</style>
