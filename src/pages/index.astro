---
import CalendarWidget from '../components/CalendarWidget.astro';
import EmailWidget    from '../components/EmailWidget.astro';
import Shortcuts      from '../components/Shortcuts.astro';
import AuthPanel      from '../components/AuthPanel.astro';
import '../styles/theme.css';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <title>New Tab</title>
  <!-- Roboto — MD3 reference typeface -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet" />
</head>
<body>

  <!-- ── Wallpaper backdrop (decorative, behind all MD3 surfaces) ── -->
  <div class="backdrop" aria-hidden="true">
    <img src="/images/naruto-swift.png" alt="" />
  </div>

  <!-- ── MD3 Small Top App Bar ──────────────────────────────────────── -->
  <!-- spec: 64dp tall, surfaceContainer bg, titleLarge headline       -->
  <header class="top-app-bar">
    <span class="top-app-bar__headline">SergioSwift</span>
    <div class="top-app-bar__actions">
      <AuthPanel />
    </div>
  </header>

  <!-- ── Main content — 3-column expanded layout ───────────────────── -->
  <main class="layout">

    <!-- Left: Calendar card -->
    <div class="layout__col">
      <CalendarWidget />
    </div>

    <!-- Centre: Shortcuts -->
    <div class="layout__col layout__col--center">
      <Shortcuts />
    </div>

    <!-- Right: Email card -->
    <div class="layout__col">
      <EmailWidget />
    </div>

  </main>

</body>
</html>

<style>
  /* ── Backdrop ────────────────────────────────────────────────────── */
  .backdrop {
    position: fixed; inset: 0; z-index: 0;
    background: var(--md-sys-color-background);
    overflow: hidden;
  }
  .backdrop img {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.12;          /* subtle — MD3 surfaces sit on top */
  }

  /* ── MD3 Small Top App Bar ──────────────────────────────────────── */
  /* spec: h=64dp, bg=surfaceContainer, title=titleLarge, px=16dp      */
  .top-app-bar {
    position: relative; z-index: 10;
    display: flex;
    align-items: center;
    height: 64px;
    padding: 0 16px;
    background: var(--md-sys-color-surface-container);
    gap: 16px;
  }
  .top-app-bar__headline {
    flex: 1;
    font: var(--md-sys-typescale-title-large);
    color: var(--md-sys-color-on-surface);
  }
  .top-app-bar__actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* ── Expanded layout grid ───────────────────────────────────────── */
  /* 3-column: side cards share equal width, centre is narrower        */
  .layout {
    position: relative; z-index: 10;
    display: grid;
    grid-template-columns: 1fr 300px 1fr;
    gap: 16px;
    padding: 16px;
    height: calc(100vh - 64px);
    overflow: hidden;
  }
  .layout__col {
    display: flex;
    flex-direction: column;
    min-height: 0;       /* allow flex children to scroll */
    overflow: hidden;
  }
  .layout__col--center {
    justify-content: flex-start;
    padding-top: 8px;
  }
</style>
